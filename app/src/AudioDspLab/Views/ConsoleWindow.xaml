<Window x:Class="AudioDspLab.Views.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio-DSP-Lab console" Width="720" Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AudioLabWindowBackground}"
        Closed="Window_Closed">
    <DockPanel Margin="6">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <CheckBox DockPanel.Dock="Right" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"
                      Content="Show events" IsChecked="{Binding ShowEvents}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource AudioLabGoldKeyStyle}" Content="Send" Command="{Binding SendCommand}" />
            <TextBox x:Name="InputBox" Height="26" FontFamily="Consolas" FontSize="13" VerticalContentAlignment="Center"
                     Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="InputBox_PreviewKeyDown">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
        <TextBox x:Name="Log" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 Background="Black" Foreground="#FFB8F0B8" FontFamily="Consolas" FontSize="12"
                 BorderBrush="{StaticResource AudioLabSeparator}" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextChanged="Log_TextChanged" />
    </DockPanel>
</Window>

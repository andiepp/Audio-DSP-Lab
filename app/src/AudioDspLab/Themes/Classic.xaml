<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- The look of the author's RF-Lab application: black ground, white
         section headings, light-yellow settings blocks with blue labels,
         maroon and dark-blue signal displays, silver and gold keys. -->

    <SolidColorBrush x:Key="AudioLabWindowBackground" Color="Black" />
    <SolidColorBrush x:Key="AudioLabSeparator" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="AudioLabSettingsBackground" Color="LightYellow" />
    <SolidColorBrush x:Key="AudioLabSettingsLabel" Color="Blue" />
    <SolidColorBrush x:Key="AudioLabFrequencyBackground" Color="Maroon" />
    <SolidColorBrush x:Key="AudioLabAmplitudeBackground" Color="DarkBlue" />
    <SolidColorBrush x:Key="AudioLabUnitText" Color="#FFB0B0B0" />
    <SolidColorBrush x:Key="AudioLabDimText" Color="#FFC8C8C8" />
    <SolidColorBrush x:Key="AudioLabWarningText" Color="Gold" />
    <SolidColorBrush x:Key="AudioLabErrorText" Color="#FFFF6060" />

    <!-- Every theme defines the keys below as well (Studio*.xaml). -->
    <SolidColorBrush x:Key="AudioLabText" Color="White" />
    <SolidColorBrush x:Key="AudioLabTextOnBlock" Color="Black" />
    <SolidColorBrush x:Key="AudioLabAccentText" Color="Gold" />
    <SolidColorBrush x:Key="AudioLabTopBarBackground" Color="LightYellow" />
    <SolidColorBrush x:Key="AudioLabMarkerBackground" Color="Gold" />
    <SolidColorBrush x:Key="AudioLabMarkerText" Color="Black" />
    <SolidColorBrush x:Key="AudioLabMarkerP1" Color="Gold" />
    <SolidColorBrush x:Key="AudioLabMarkerP2" Color="Gold" />
    <SolidColorBrush x:Key="AudioLabMarkerP3" Color="Gold" />
    <SolidColorBrush x:Key="AudioLabMarkerP4" Color="Gold" />
    <SolidColorBrush x:Key="AudioLabDisplayTitle" Color="White" />
    <SolidColorBrush x:Key="AudioLabDisplayFrame" Color="#FFB0B0B0" />
    <SolidColorBrush x:Key="AudioLabDisplayValue" Color="White" />
    <SolidColorBrush x:Key="AudioLabDialSelection" Color="Gold" />
    <SolidColorBrush x:Key="AudioLabDialArrow" Color="#90FFFFFF" />
    <SolidColorBrush x:Key="AudioLabChartBackground" Color="Black" />
    <SolidColorBrush x:Key="AudioLabChartGrid" Color="#FF333333" />
    <SolidColorBrush x:Key="AudioLabChartZero" Color="#FF777777" />
    <SolidColorBrush x:Key="AudioLabChartLeft" Color="Gold" />
    <SolidColorBrush x:Key="AudioLabChartRight" Color="#FF3FC8FF" />
    <SolidColorBrush x:Key="AudioLabChartReference" Color="#FF909090" />
    <SolidColorBrush x:Key="AudioLabChartLabel" Color="#FFB0B0B0" />
    <SolidColorBrush x:Key="AudioLabChartReadout" Color="#FF111111" />
    <SolidColorBrush x:Key="AudioLabChartMarker" Color="White" />
    <SolidColorBrush x:Key="AudioLabNoteBackground" Color="#FFFFF3B0" />
    <SolidColorBrush x:Key="AudioLabNoteBorder" Color="#FFD4A000" />
    <SolidColorBrush x:Key="AudioLabNoteText" Color="#FF5A4300" />
    <SolidColorBrush x:Key="AudioLabListBackground" Color="Black" />
    <SolidColorBrush x:Key="AudioLabListText" Color="White" />
    <SolidColorBrush x:Key="AudioLabLogBackground" Color="Black" />
    <SolidColorBrush x:Key="AudioLabLogText" Color="#FFB8F0B8" />
    <SolidColorBrush x:Key="AudioLabStatusOk" Color="LimeGreen" />
    <SolidColorBrush x:Key="AudioLabStatusError" Color="Red" />
    <SolidColorBrush x:Key="AudioLabStatusIdle" Color="Gray" />

    <!-- The pots' knob caps, as on the author's board: P1 blue, P2 green,
         P3 yellow, P4 red; a dark knob body around them. -->
    <SolidColorBrush x:Key="AudioLabPot1" Color="#FF1E7FD6" />
    <SolidColorBrush x:Key="AudioLabPot2" Color="#FF1FA35A" />
    <SolidColorBrush x:Key="AudioLabPot3" Color="#FFF2CC3E" />
    <SolidColorBrush x:Key="AudioLabPot4" Color="#FFD9453B" />
    <SolidColorBrush x:Key="AudioLabKnobBody" Color="#FF202020" />
    <SolidColorBrush x:Key="AudioLabKnobRing" Color="#FFB0B0B0" />
    <SolidColorBrush x:Key="AudioLabKnobTrack" Color="Transparent" />
    <SolidColorBrush x:Key="AudioLabKnobLabel" Color="White" />
    <SolidColorBrush x:Key="AudioLabKnobRole" Color="#FFB0B0B0" />

    <!-- Shapes and type the themes differ in. -->
    <FontFamily x:Key="AudioLabDigitFont">Calibri</FontFamily>
    <sys:Double x:Key="AudioLabDigitWidth">0.52</sys:Double>
    <CornerRadius x:Key="AudioLabDisplayCornerRadius">0</CornerRadius>
    <Thickness x:Key="AudioLabDisplayFrameThickness">1</Thickness>
    <Thickness x:Key="AudioLabDisplayPadding">4,2,4,4</Thickness>
    <Thickness x:Key="AudioLabDisplayBodyPadding">8,0</Thickness>
    <HorizontalAlignment x:Key="AudioLabDisplayTitleAlignment">Center</HorizontalAlignment>
    <FontWeight x:Key="AudioLabDisplayTitleWeight">Bold</FontWeight>
    <sys:Boolean x:Key="AudioLabKnobShowsArc">False</sys:Boolean>

    <!-- Section heading: white on black over a thin rule, as "Signal",
         "Modulation" and "Instrument" in RF-Lab. -->
    <Style x:Key="AudioLabHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Margin" Value="4,6,4,3" />
    </Style>

    <Style x:Key="AudioLabHeaderRuleStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource AudioLabSeparator}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style x:Key="AudioLabInfoStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource AudioLabDimText}" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AudioLabUnitLineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource AudioLabUnitText}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,3,0,2" />
    </Style>

    <!-- The light-yellow settings block; dimmed as a whole when its
         controls do not apply. -->
    <Style x:Key="AudioLabSettingsBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AudioLabSettingsBackground}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="2,0,2,2" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AudioLabSettingsLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AudioLabSettingsLabel}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="2,0,8,0" />
    </Style>

    <Style x:Key="AudioLabRadioStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource AudioLabSettingsLabel}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="2,4,14,4" />
    </Style>

    <Style x:Key="AudioLabEntryStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="96" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="#FFB0B0B0" />
    </Style>

    <!-- Keys: silver, gold for the deliberate ones; the RF-Lab templates,
         with a visible disabled state instead of RF-Lab's vanishing one. -->
    <Style x:Key="AudioLabKeyStyle" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Overlay" Background="Silver" BorderBrush="Black"
                            BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="BorderBrush" Value="WhiteSmoke" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Overlay" Property="Background" Value="#FF3A3A3A" />
                            <Setter Property="Foreground" Value="#FF8A8A8A" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AudioLabGoldKeyStyle" TargetType="Button" BasedOn="{StaticResource AudioLabKeyStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Overlay" Background="Gold" BorderBrush="Black"
                            BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="BorderBrush" Value="WhiteSmoke" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Overlay" Property="Background" Value="#FF3A3A3A" />
                            <Setter Property="Foreground" Value="#FF8A8A8A" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On/off keys: RF-Lab's toggle, pale green when on. -->
    <Style x:Key="AudioLabToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource AudioLabKeyStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Overlay" Background="Silver" BorderBrush="Black"
                            BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="PaleGreen" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="BorderBrush" Value="WhiteSmoke" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Overlay" Property="Background" Value="#FF3A3A3A" />
                            <Setter Property="Foreground" Value="#FF8A8A8A" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The application state, as a pill coloured by what it means. -->
    <Style x:Key="AudioLabStatePillStyle" TargetType="Border">
        <Setter Property="Background" Value="Silver" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsStateRunning}" Value="True">
                <Setter Property="Background" Value="PaleGreen" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsServiceMode}" Value="True">
                <Setter Property="Background" Value="Gold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsStateFailed}" Value="True">
                <Setter Property="Background" Value="#FFFF8080" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A station of the radio: a plain key, pale green while the board
         plays it. Not a toggle: a click on the station playing changes
         nothing, and the key must not pretend it did. -->
    <Style x:Key="AudioLabStationKeyStyle" TargetType="Button" BasedOn="{StaticResource AudioLabKeyStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Overlay" Background="Silver" BorderBrush="Black"
                            BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="PaleGreen" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="BorderBrush" Value="WhiteSmoke" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Overlay" Property="Background" Value="#FF3A3A3A" />
                            <Setter Property="Foreground" Value="#FF8A8A8A" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The radio's connection, as a pill coloured by what it means. -->
    <Style x:Key="AudioLabConnectionPillStyle" TargetType="Border">
        <Setter Property="Background" Value="Silver" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                <Setter Property="Background" Value="PaleGreen" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                <Setter Property="Background" Value="Gold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsConnectionFailed}" Value="True">
                <Setter Property="Background" Value="#FFFF8080" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

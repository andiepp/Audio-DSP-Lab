<UserControl x:Class="AudioDspLab.Controls.PotKnob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- One board potentiometer: a knob whose pointer stands where the pot
         stands, its name, and what it drives in the running application. -->
    <StackPanel Margin="10,2">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Opacity" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAssigned, ElementName=Root}" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <Grid Width="40" Height="40" HorizontalAlignment="Center">
            <Ellipse Fill="#FF202020" Stroke="#FFB0B0B0" StrokeThickness="1.5" />
            <Rectangle x:Name="Pointer" Width="3" Height="15" Fill="White"
                       VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,3,0,0"
                       RenderTransformOrigin="0.5,1.1">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="PointerRotation" Angle="{Binding Angle, ElementName=Root}" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
        <TextBlock HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" Margin="0,3,0,0">
            <Run Text="{Binding Label, ElementName=Root, Mode=OneWay}" />
            <Run Text="{Binding Role, ElementName=Root, Mode=OneWay}" Foreground="#FFB0B0B0" FontWeight="Normal" />
        </TextBlock>
    </StackPanel>
</UserControl>

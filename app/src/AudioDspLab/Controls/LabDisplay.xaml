<UserControl x:Class="AudioDspLab.Controls.LabDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- The RF-Lab signal display: a coloured block with its title on top
         and its body, the digits, in an inset frame. -->
    <Border Background="{Binding DisplayBackground, ElementName=Root}" Padding="4,2,4,4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- the badge floats over the title's right end rather than taking its
                 room: narrow dials keep their whole title -->
            <Grid Grid.Row="0" Margin="2,0,2,2">
                <Border x:Name="MarkerBadge" Panel.ZIndex="1" HorizontalAlignment="Right" Background="Gold" CornerRadius="2"
                        Padding="5,0" Margin="6,2,0,2" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMarked, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Marker, ElementName=Root}" Foreground="Black"
                               FontWeight="Bold" FontSize="{Binding MarkerFontSize, ElementName=Root}" />
                </Border>
                <TextBlock Text="{Binding Title, ElementName=Root}" Foreground="White" FontWeight="Bold"
                           FontSize="{Binding TitleFontSize, ElementName=Root}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1" BorderBrush="#FFB0B0B0" BorderThickness="1" Padding="8,0">
                <ContentPresenter Content="{Binding Body, ElementName=Root}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</UserControl>

    <SolidColorBrush x:Key="AudioLabKnobLabel" Color="#FFE7EBF1" />
    <SolidColorBrush x:Key="AudioLabKnobRole" Color="#FF8B97A8" />

    <FontFamily x:Key="AudioLabDigitFont">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="AudioLabDigitWidth">0.6</sys:Double>
    <CornerRadius x:Key="AudioLabDisplayCornerRadius">10</CornerRadius>
    <Thickness x:Key="AudioLabDisplayFrameThickness">0</Thickness>
    <Thickness x:Key="AudioLabDisplayPadding">5,4,5,6</Thickness>
    <Thickness x:Key="AudioLabDisplayBodyPadding">0</Thickness>
    <HorizontalAlignment x:Key="AudioLabDisplayTitleAlignment">Left</HorizontalAlignment>
    <FontWeight x:Key="AudioLabDisplayTitleWeight">Normal</FontWeight>
    <sys:Boolean x:Key="AudioLabKnobShowsArc">True</sys:Boolean>

    <!-- Studio only: the surfaces and the accent the styles use -->
    <SolidColorBrush x:Key="StudioSurface" Color="#FF212833" />
    <SolidColorBrush x:Key="StudioLine" Color="#FF2B3440" />
    <SolidColorBrush x:Key="StudioLineHover" Color="#FF3E4A5B" />
    <SolidColorBrush x:Key="StudioPressed" Color="#FF2B3440" />
    <SolidColorBrush x:Key="StudioAccent" Color="#FF2FC4B2" />
    <SolidColorBrush x:Key="StudioOnAccent" Color="#FF0E1116" />
    <SolidColorBrush x:Key="StudioDanger" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="StudioOnDanger" Color="#FF0E1116" />
    <SolidColorBrush x:Key="StudioCaution" Color="#FFF0B54A" />
</ResourceDictionary>

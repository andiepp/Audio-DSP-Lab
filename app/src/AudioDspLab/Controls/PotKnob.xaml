<UserControl x:Class="AudioDspLab.Controls.PotKnob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- One board potentiometer, drawn like the board's knobs: a dark body
         with a coloured teardrop cap whose tip points where the pot stands
         (P1 blue, P2 green, P3 yellow, P4 red). A theme may add an arc
         gauge in the cap's colour around it. Its name and what it drives
         below. -->
    <StackPanel Margin="10,2">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Opacity" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAssigned, ElementName=Root}" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <Grid Width="48" Height="48" HorizontalAlignment="Center">
            <Path x:Name="TrackArc" Stroke="{DynamicResource AudioLabKnobTrack}" StrokeThickness="3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="ValueArc" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Ellipse Width="36" Height="36" Fill="{DynamicResource AudioLabKnobBody}"
                     Stroke="{DynamicResource AudioLabKnobRing}" StrokeThickness="1.5" />
            <Path x:Name="Cap" Width="24" Height="24" Stretch="None"
                  Data="M 12,1 L 17.49,6.18 A 8,8 0 1 1 6.51,6.18 Z"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <RotateTransform x:Name="PointerRotation" Angle="{Binding Angle, ElementName=Root}" />
                </Path.RenderTransform>
            </Path>
        </Grid>
        <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource AudioLabKnobLabel}" FontWeight="Bold" Margin="0,3,0,0">
            <Run Text="{Binding Label, ElementName=Root, Mode=OneWay}" />
            <Run Text="{Binding Role, ElementName=Root, Mode=OneWay}" Foreground="{DynamicResource AudioLabKnobRole}" FontWeight="Normal" />
        </TextBlock>
    </StackPanel>
</UserControl>

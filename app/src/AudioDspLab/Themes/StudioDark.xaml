<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Studio dark: slate surfaces, one teal accent for "on / selected",
         the knob colours for the pots. The styles are in StudioStyles.xaml;
         this file holds the colours (the same keys as Classic.xaml, plus
         the Studio ones at the end). -->

    <SolidColorBrush x:Key="AudioLabWindowBackground" Color="#FF11151B" />
    <SolidColorBrush x:Key="AudioLabSeparator" Color="#FF2B3440" />
    <SolidColorBrush x:Key="AudioLabSettingsBackground" Color="#FF1A2028" />
    <SolidColorBrush x:Key="AudioLabSettingsLabel" Color="#FF8B97A8" />
    <SolidColorBrush x:Key="AudioLabFrequencyBackground" Color="#FF1A2028" />
    <SolidColorBrush x:Key="AudioLabAmplitudeBackground" Color="#FF1A2028" />
    <SolidColorBrush x:Key="AudioLabUnitText" Color="#FF6F7B8C" />
    <SolidColorBrush x:Key="AudioLabDimText" Color="#FF8B97A8" />
    <SolidColorBrush x:Key="AudioLabWarningText" Color="#FFF0B54A" />
    <SolidColorBrush x:Key="AudioLabErrorText" Color="#FFFF6B6B" />

    <SolidColorBrush x:Key="AudioLabText" Color="#FFE7EBF1" />
    <SolidColorBrush x:Key="AudioLabTextOnBlock" Color="#FFE7EBF1" />
    <SolidColorBrush x:Key="AudioLabAccentText" Color="#FF2FC4B2" />
    <SolidColorBrush x:Key="AudioLabTopBarBackground" Color="#FF161B22" />
    <SolidColorBrush x:Key="AudioLabMarkerBackground" Color="#FFF0B54A" />
    <SolidColorBrush x:Key="AudioLabMarkerText" Color="#FF0E1116" />
    <SolidColorBrush x:Key="AudioLabMarkerP1" Color="#FF1E7FD6" />

<Window x:Class="AudioDspLab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AudioDspLab.Controls"
        Title="{Binding Title}"
        Icon="pack://application:,,,/AudioDspLab;component/AudioDspLab.ico"
        Width="1000" SizeToContent="Height"
        MinWidth="920" MinHeight="600"
        Background="{DynamicResource AudioLabWindowBackground}"
        FontSize="11"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- a choice: one lit key per name -->
        <DataTemplate x:Key="ChoiceKeys">
            <ItemsControl ItemsSource="{Binding Keys}" Margin="0,2,6,2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource AudioLabStationKeyStyle}" Height="22" Padding="2,0" FontSize="10"
                                Content="{Binding Label}" ToolTip="{Binding Label}"
                                Command="{Binding SelectCommand}" CommandParameter="{Binding Name}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- one value of the synthesizer's voice: a small dial, its pot marker, its unit -->
        <Style x:Key="SynthUnitLineStyle" TargetType="TextBlock" BasedOn="{StaticResource AudioLabUnitLineStyle}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,1,0,1" />
        </Style>
        <Style x:Key="SynthHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource AudioLabHeaderStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="4,2,4,1" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="4,0,6,2" />
            <Setter Property="Foreground" Value="{StaticResource AudioLabDimText}" />
        </Style>
        <DataTemplate x:Key="SmallDial">
            <StackPanel Margin="0,0,6,0">
                <controls:LabDisplay Title="{Binding Title}" TitleFontSize="11" MarkerFontSize="10"
                                     Marker="{Binding Knob}" IsMarked="{Binding IsChangedOnBoard}"
                                     DisplayBackground="{StaticResource AudioLabAmplitudeBackground}">
                    <controls:LabDisplay.Body>
                        <controls:DigitDial IntegerDigits="{Binding IntegerDigits}" FractionDigits="{Binding FractionDigits}"
                                            ShowSign="{Binding ShowSign}" ShowPlus="{Binding ShowSign}" DigitFontSize="16"
                                            Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                            Value="{Binding DialValue}" />
                    </controls:LabDisplay.Body>
                </controls:LabDisplay>
                <TextBlock Style="{StaticResource SynthUnitLineStyle}" Text="{Binding UnitLine}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- ============ Connection ============ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource AudioLabTopBarBackground}"
                BorderBrush="{StaticResource AudioLabSeparator}" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AudioLabSettingsLabelStyle}" Text="Theme" />
                    <ComboBox x:Name="ThemeBox" Width="110" Height="24" Margin="0,0,8,0" VerticalContentAlignment="Center"
                              ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding SelectedTheme}" />
                    <Button x:Name="ConsoleKey" Style="{StaticResource AudioLabKeyStyle}" Content="Console"
                            ToolTip="Talk the board's protocol by hand" Click="Console_Click"
                            IsEnabled="{Binding IsConnected}" />
                    <Button x:Name="HelpKey" Style="{StaticResource AudioLabKeyStyle}" Content="Manual"
                            ToolTip="Open the manual on GitHub" Click="Manual_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AudioLabSettingsLabelStyle}" Text="Board on" FontWeight="Bold" />
                    <ComboBox x:Name="PortBox" Width="150" Height="24" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                              IsEnabled="{Binding IsDisconnected}" />
                    <Button Style="{StaticResource AudioLabKeyStyle}" MinWidth="28" Content="↻" ToolTip="Look for ports again"
                            Command="{Binding RefreshPortsCommand}" />
                    <Button x:Name="ConnectKey" Style="{StaticResource AudioLabGoldKeyStyle}" Content="Connect"
                            Command="{Binding ConnectCommand}" />
                    <Button x:Name="DisconnectKey" Style="{StaticResource AudioLabKeyStyle}" Content="Disconnect"
                            Command="{Binding DisconnectCommand}" />
                    <TextBlock x:Name="ConnectionText" Style="{StaticResource AudioLabSettingsLabelStyle}" Margin="10,0,0,0"
                               Text="{Binding ConnectionText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Left: application, page, pots ============ -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="2,0,2,0">

            <!-- Application -->
            <Border Style="{StaticResource AudioLabHeaderRuleStyle}" BorderThickness="0">
                <TextBlock Style="{StaticResource AudioLabHeaderStyle}" Text="Application" />
            </Border>
            <Border Style="{StaticResource AudioLabSettingsBlockStyle}">
                <DockPanel>
                    <Border x:Name="StatePill" DockPanel.Dock="Right" Style="{StaticResource AudioLabStatePillStyle}">
                        <TextBlock x:Name="StateText" Text="{Binding ApplicationStateText}" FontWeight="Bold" />
                    </Border>
                    <ItemsControl x:Name="ApplicationKeys" ItemsSource="{Binding ApplicationKeys}" Margin="0,0,8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AudioLabStationKeyStyle}" Margin="0,2,4,2"
                                        Content="{Binding Label}" Command="{Binding SelectCommand}" CommandParameter="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Radio strip: above the equalizer page while the radio is selected -->
            <StackPanel x:Name="RadioStrip" DataContext="{Binding Radio}"
                        Visibility="{Binding DataContext.IsRadioSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                <Border Style="{StaticResource AudioLabHeaderRuleStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0">
                            <TextBlock Foreground="{StaticResource AudioLabDimText}" VerticalAlignment="Center"
                                       Margin="0,0,6,0" Text="Connection" />
                            <Border x:Name="ConnectionPill" Style="{StaticResource AudioLabConnectionPillStyle}">
                                <TextBlock x:Name="RadioConnectionText" Text="{Binding ConnectionText}" FontWeight="Bold" />
                            </Border>
                            <TextBlock Foreground="{StaticResource AudioLabDimText}" VerticalAlignment="Center"
                                       Margin="14,0,6,0" Text="Stream" />
                            <TextBlock x:Name="SampleRateText" Foreground="{DynamicResource AudioLabText}" VerticalAlignment="Center"
                                       Text="{Binding SampleRateText}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource AudioLabHeaderStyle}" Text="Radio" />
                    </DockPanel>
                </Border>
                <Grid Margin="2,0,2,0" IsEnabled="{Binding IsRunning}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:LabDisplay x:Name="StationDisplay" Grid.Column="0" Title="Station" TitleFontSize="16"
                                         DisplayBackground="{StaticResource AudioLabAmplitudeBackground}">
                        <controls:LabDisplay.Body>
                            <StackPanel Width="272">
                                <TextBlock Text="{Binding StationName}" Foreground="{DynamicResource AudioLabDisplayValue}" FontSize="26"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StreamTitleText}" ToolTip="{Binding StreamTitle}"
                                           Foreground="{DynamicResource AudioLabAccentText}" FontSize="12" Margin="0,2,0,4"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </controls:LabDisplay.Body>
                    </controls:LabDisplay>
                    <StackPanel Grid.Column="2">
                        <ItemsControl x:Name="StationKeys" ItemsSource="{Binding Stations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource AudioLabStationKeyStyle}"
                                            Content="{Binding Name}" ToolTip="{Binding Url}"
                                            Command="{Binding SelectCommand}" CommandParameter="{Binding Index}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="2,2,0,0">
                            <Button x:Name="EditStationsKey" DockPanel.Dock="Right" Style="{StaticResource AudioLabKeyStyle}"
                                    Content="Edit stations" Click="EditStations_Click" />
                            <Button x:Name="WifiKey" DockPanel.Dock="Right" Style="{StaticResource AudioLabKeyStyle}"
                                    Content="WiFi" Click="Wifi_Click" />
                            <TextBlock x:Name="WifiText" Foreground="{StaticResource AudioLabDimText}" VerticalAlignment="Center"
                                       Text="{Binding WifiText}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Page heading -->
            <Border Style="{StaticResource AudioLabHeaderRuleStyle}">
                <DockPanel>
                    <TextBlock x:Name="GateText" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="4,0,6,4"
                               Foreground="{StaticResource AudioLabWarningText}"
                               Text="{Binding GateExplanation}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource AudioLabHeaderStyle}" Text="{Binding SignalHeading}" />
                </DockPanel>
            </Border>

            <!-- Generator page -->
            <StackPanel x:Name="GeneratorPage" DataContext="{Binding Generator}"
                        Visibility="{Binding DataContext.IsGeneratorPageShown, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                <Grid Margin="2,0,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="230" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="104" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:LabDisplay x:Name="FrequencyDisplay" Grid.Column="0" Title="Frequency" Marker="{Binding Frequency.Knob}"
                                         DisplayBackground="{StaticResource AudioLabFrequencyBackground}"
                                         IsMarked="{Binding Frequency.IsChangedOnBoard}">
                        <controls:LabDisplay.Body>
                            <controls:DigitDial IntegerDigits="5" FractionDigits="2" DigitFontSize="56"
                                                Minimum="20" Maximum="20000"
                                                IsEnabled="{Binding IsRunning}"
                                                Value="{Binding Frequency.DialValue}" />
                        </controls:LabDisplay.Body>
                    </controls:LabDisplay>
                    <controls:LabDisplay x:Name="AmplitudeDisplay" Grid.Column="2" Title="A" Marker="{Binding Amplitude.Knob}"
                                         DisplayBackground="{StaticResource AudioLabAmplitudeBackground}"
                                         IsMarked="{Binding Amplitude.IsChangedOnBoard}">
                        <controls:LabDisplay.Body>
                            <controls:DigitDial IntegerDigits="2" FractionDigits="2" ShowSign="True" DigitFontSize="56"
                                                Minimum="-60" Maximum="0"
                                                IsEnabled="{Binding IsRunning}"
                                                Value="{Binding Amplitude.DialValue}" />
                        </controls:LabDisplay.Body>
                    </controls:LabDisplay>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource AudioLabUnitLineStyle}" Text="---- Hz ----" />
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="-- dBFS --" />
                        <TextBlock x:Name="RmsText" HorizontalAlignment="Center" Foreground="{StaticResource AudioLabDimText}"
                                   Text="{Binding ApproximateRmsText}"
                                   ToolTip="Approximate: derived from Elektor's 0.9 Vrms at full scale; the analog output stage sets the real level." />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource AudioLabHeaderStyle}" Text="Generator" />
                </Border>
                <Border x:Name="GeneratorBlock" Style="{StaticResource AudioLabSettingsBlockStyle}" IsEnabled="{Binding IsRunning}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="44" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource AudioLabSettingsLabelStyle}" Text="Waveform" />
                        <ContentControl x:Name="WaveformKeys" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Width="500"
                                        HorizontalAlignment="Left"
                                        Content="{Binding Waveform}" ContentTemplate="{StaticResource ChoiceKeys}" />
                        <Border Grid.Row="0" Grid.Column="3" Background="{DynamicResource AudioLabMarkerP1}" CornerRadius="3" Padding="5,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Waveform.IsChangedOnBoard}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="P1" FontWeight="Bold" Foreground="{DynamicResource AudioLabMarkerText}" />
                        </Border>

                        <TextBlock Grid.Row="1" Style="{StaticResource AudioLabSettingsLabelStyle}" Text="Width" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="WidthDial" Background="{StaticResource AudioLabAmplitudeBackground}" Padding="6,0"
                                    CornerRadius="{DynamicResource AudioLabDisplayCornerRadius}" IsEnabled="{Binding HasWidth}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <controls:DigitDial IntegerDigits="2" FractionDigits="0" DigitFontSize="20"
                                                    Minimum="5" Maximum="95" Value="{Binding Width.DialValue}" />
                            </Border>
                            <TextBlock Style="{StaticResource AudioLabSettingsLabelStyle}" Margin="8,0,0,0" Text="{Binding WidthHint}" />
                        </StackPanel>
                        <Border Grid.Row="1" Grid.Column="3" Background="{DynamicResource AudioLabMarkerP3}" CornerRadius="3" Padding="5,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Width.IsChangedOnBoard}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="P3" FontWeight="Bold" Foreground="{DynamicResource AudioLabMarkerText}" />
                        </Border>

                        <TextBlock Grid.Row="2" Style="{StaticResource AudioLabSettingsLabelStyle}" Text="F" />
                        <TextBox x:Name="FrequencyBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource AudioLabEntryStyle}" Height="24"
                                 ToolTip="Hertz; a trailing k means kilohertz. Enter applies, Escape gives up."
                                 Text="{Binding FrequencyText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ApplyFrequencyTextCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding RevertFrequencyTextCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <StackPanel x:Name="FrequencyKeys" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="20" Command="{Binding SetFrequencyCommand}" CommandParameter="20" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="50" Command="{Binding SetFrequencyCommand}" CommandParameter="50" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="100" Command="{Binding SetFrequencyCommand}" CommandParameter="100" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="200" Command="{Binding SetFrequencyCommand}" CommandParameter="200" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="500" Command="{Binding SetFrequencyCommand}" CommandParameter="500" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="1k" Command="{Binding SetFrequencyCommand}" CommandParameter="1000" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="2k" Command="{Binding SetFrequencyCommand}" CommandParameter="2000" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="5k" Command="{Binding SetFrequencyCommand}" CommandParameter="5000" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="10k" Command="{Binding SetFrequencyCommand}" CommandParameter="10000" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="15k" Command="{Binding SetFrequencyCommand}" CommandParameter="15000" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="20k" Command="{Binding SetFrequencyCommand}" CommandParameter="20000" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Style="{StaticResource AudioLabSettingsLabelStyle}" Text="P2 range" />
                        <ContentControl x:Name="P2RangeKeys" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Width="300"
                                        HorizontalAlignment="Left"
                                        Content="{Binding P2Range}" ContentTemplate="{StaticResource ChoiceKeys}" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource AudioLabSettingsLabelStyle}"
                                   Text="the decade P2 sweeps" />

                        <TextBlock Grid.Row="4" Style="{StaticResource AudioLabSettingsLabelStyle}" Text="A" />
                        <TextBox x:Name="AmplitudeBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource AudioLabEntryStyle}" Height="24"
                                 ToolTip="dBFS, -60 to 0. Enter applies, Escape gives up."
                                 Text="{Binding AmplitudeText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ApplyAmplitudeTextCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding RevertAmplitudeTextCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <StackPanel x:Name="AmplitudeKeys" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="-60" Command="{Binding SetAmplitudeCommand}" CommandParameter="-60" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="-50" Command="{Binding SetAmplitudeCommand}" CommandParameter="-50" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="-40" Command="{Binding SetAmplitudeCommand}" CommandParameter="-40" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="-30" Command="{Binding SetAmplitudeCommand}" CommandParameter="-30" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="-20" Command="{Binding SetAmplitudeCommand}" CommandParameter="-20" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="-10" Command="{Binding SetAmplitudeCommand}" CommandParameter="-10" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="-6" Command="{Binding SetAmplitudeCommand}" CommandParameter="-6" />
                            <Button Style="{StaticResource AudioLabKeyStyle}" Content="0" Command="{Binding SetAmplitudeCommand}" CommandParameter="0" />
                        </StackPanel>

                        <TextBlock Grid.Row="5" Style="{StaticResource AudioLabSettingsLabelStyle}" Text="Output" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                            <ToggleButton x:Name="OutputKey" Style="{StaticResource AudioLabToggleStyle}"
                                          Width="130" Height="34" FontSize="13" FontWeight="Bold"
                                          Content="{Binding Output.OnOffText}"
                                          IsChecked="{Binding Output.IsOn, Mode=OneWay}"
                                          Command="{Binding Output.ToggleCommand}" />
                            <TextBlock Style="{StaticResource AudioLabSettingsLabelStyle}" Margin="12,0,0,0"
                                       Text="K3 and K4 · off after every application start" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Equalizer page: for the equalizer and the radio -->
            <StackPanel x:Name="EqualizerPage" DataContext="{Binding Equalizer}" IsEnabled="{Binding IsRunning}"
                        Visibility="{Binding DataContext.IsEqualizerPageShown, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                <Border Margin="2,0,2,0" BorderBrush="{StaticResource AudioLabSeparator}" BorderThickness="1">
                    <controls:ResponseCurve x:Name="Curve" Height="170"
                                            Response="{Binding Response}" MarkerFrequencies="{Binding MarkerFrequencies}" />
                </Border>
                <TextBlock Margin="6,2,0,0" Foreground="{StaticResource AudioLabDimText}"
                           Text="Computed from the three filters, not measured." />
                <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,4,0,0">
                    <DockPanel>
                        <TextBlock Style="{StaticResource HintStyle}" Text="Wheel over a digit, or click its upper or lower half" />
                        <TextBlock Style="{StaticResource AudioLabHeaderStyle}" Text="Equalizer" />
                    </DockPanel>
                </Border>
                <ItemsControl x:Name="BandStrip" ItemsSource="{Binding Bands}" Margin="2,0,2,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,6,0">
                                <controls:LabDisplay Title="{Binding GainTitle}" TitleFontSize="16" Marker="{Binding Gain.Knob}"
                                                     DisplayBackground="{StaticResource AudioLabAmplitudeBackground}"
                                                     IsMarked="{Binding Gain.IsChangedOnBoard}">
                                    <controls:LabDisplay.Body>
                                        <controls:DigitDial IntegerDigits="2" FractionDigits="2" ShowSign="True" ShowPlus="True"
                                                            DigitFontSize="34" Minimum="-12" Maximum="12"
                                                            Value="{Binding Gain.DialValue}" />
                                    </controls:LabDisplay.Body>
                                </controls:LabDisplay>
                                <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="-- dB --" />
                                <controls:LabDisplay Title="{Binding FrequencyTitle}" TitleFontSize="13"
                                                     DisplayBackground="{StaticResource AudioLabFrequencyBackground}">
                                    <controls:LabDisplay.Body>
                                        <controls:DigitDial IntegerDigits="5" FractionDigits="2" DigitFontSize="22"
                                                            Minimum="{Binding Frequency.Minimum}" Maximum="{Binding Frequency.Maximum}"
                                                            Value="{Binding Frequency.DialValue}" />
                                    </controls:LabDisplay.Body>
                                </controls:LabDisplay>
                                <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="{Binding RangeText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="2,4,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="1.6*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <controls:LabDisplay x:Name="EqualizerVolumeDisplay" Title="Volume" TitleFontSize="16" Marker="P4"
                                             DisplayBackground="{StaticResource AudioLabAmplitudeBackground}"
                                             IsMarked="{Binding Volume.IsChangedOnBoard}">
                            <controls:LabDisplay.Body>
                                <controls:DigitDial IntegerDigits="2" FractionDigits="2" ShowSign="True" DigitFontSize="34"
                                                    Minimum="-60" Maximum="0" Value="{Binding Volume.DialValue}" />
                            </controls:LabDisplay.Body>
                        </controls:LabDisplay>
                        <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="-- dB --" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource AudioLabSettingsBlockStyle}" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource AudioLabSettingsLabelStyle}" Text="Output" />
                            <ToggleButton x:Name="EqualizerOutputKey" Style="{StaticResource AudioLabToggleStyle}"
                                          Width="130" Height="34" FontSize="13" FontWeight="Bold"
                                          Content="{Binding Output.OnOffText}"
                                          IsChecked="{Binding Output.IsOn, Mode=OneWay}"
                                          Command="{Binding Output.ToggleCommand}" />
                            <TextBlock Style="{StaticResource AudioLabSettingsLabelStyle}" Margin="12,0,0,0" Text="{Binding OutputNote}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Analyzer page -->
            <StackPanel x:Name="AnalyzerPage" DataContext="{Binding Analyzer}" IsEnabled="{Binding IsRunning}"
                        Visibility="{Binding DataContext.IsAnalyzerSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                <DockPanel Margin="6,0,6,2">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Foreground="{StaticResource AudioLabDimText}" VerticalAlignment="Center" Margin="0,0,8,0" Text="Measure" />
                        <RadioButton x:Name="ResponseModeChoice" GroupName="AnalyzerMode" Foreground="{DynamicResource AudioLabText}" VerticalContentAlignment="Center"
                                     Margin="0,0,10,0" Content="Frequency Response" FontWeight="Bold"
                                     IsChecked="{Binding IsResponseMode, Mode=OneWay}"
                                     Command="{Binding ShowModeCommand}" CommandParameter="response" />
                        <RadioButton x:Name="DistortionModeChoice" GroupName="AnalyzerMode" Foreground="{DynamicResource AudioLabText}" VerticalContentAlignment="Center"
                                     Margin="0,0,10,0" Content="THD" FontWeight="Bold"
                                     IsChecked="{Binding IsThdMode, Mode=OneWay}"
                                     Command="{Binding ShowModeCommand}" CommandParameter="thd" />
                        <RadioButton x:Name="SpectrumModeChoice" GroupName="AnalyzerMode" Foreground="{DynamicResource AudioLabText}" VerticalContentAlignment="Center"
                                     Content="Spectrum" FontWeight="Bold"
                                     IsChecked="{Binding IsSpectrumMode, Mode=OneWay}"
                                     Command="{Binding ShowModeCommand}" CommandParameter="spectrum" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                Visibility="{Binding IsResponseMode, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Foreground="{StaticResource AudioLabDimText}" VerticalAlignment="Center" Margin="0,0,8,0" Text="Show" />
                        <RadioButton x:Name="AbsoluteChoice" GroupName="ResponseMode" Foreground="{DynamicResource AudioLabText}" VerticalContentAlignment="Center"
                                     Margin="0,0,10,0" Content="Absolute dBFS"
                                     IsChecked="{Binding ShowAbsolute, Mode=OneWay}"
                                     Command="{Binding ShowRelativeCommand}" CommandParameter="absolute" />
                        <RadioButton x:Name="RelativeChoice" GroupName="ResponseMode" Foreground="{DynamicResource AudioLabText}" VerticalContentAlignment="Center"
                                     Content="Relative to reference"
                                     IsChecked="{Binding ShowRelative, Mode=OneWay}"
                                     Command="{Binding ShowRelativeCommand}" CommandParameter="relative" />
                    </StackPanel>
                    <Grid>
                        <TextBlock x:Name="ReferenceInfo" Foreground="{StaticResource AudioLabDimText}" VerticalAlignment="Center"
                                   Text="{Binding ReferenceText}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsResponseMode, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock x:Name="DistortionInfo" Foreground="{StaticResource AudioLabDimText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Text="{Binding DistortionStateText}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsThdMode, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock x:Name="SpectrumInfo" Foreground="{StaticResource AudioLabDimText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Text="{Binding SpectrumStateText}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsSpectrumMode, Converter={StaticResource VisibleWhen}}" />
                    </Grid>
                </DockPanel>
                <Border Margin="2,0,2,0" BorderBrush="{StaticResource AudioLabSeparator}" BorderThickness="1">
                    <Grid>
                        <controls:SweepChart x:Name="SweepCurve" Height="200"
                                             Points="{Binding Points}" Reference="{Binding Reference}" ShowRelative="{Binding ShowRelative}"
                                             Visibility="{Binding IsResponseMode, Converter={StaticResource VisibleWhen}}" />
                        <controls:SpectrumChart x:Name="SpectrumCurve" Height="200"
                                                Points="{Binding Spectrum}" Harmonics="{Binding Harmonics}"
                                                FundamentalHertz="{Binding FundamentalHertz}"
                                                Visibility="{Binding IsThdMode, Converter={StaticResource VisibleWhen}}" />
                        <controls:SpectrumChart x:Name="SpectrumPartCurve" Height="200"
                                                Points="{Binding SpectrumPoints}" Peaks="{Binding Peaks}"
                                                Visibility="{Binding IsSpectrumMode, Converter={StaticResource VisibleWhen}}" />
                    </Grid>
                </Border>
                <TextBlock Margin="6,2,0,0" Foreground="{StaticResource AudioLabDimText}"
                           Visibility="{Binding IsResponseMode, Converter={StaticResource VisibleWhen}}">
                    <Run Foreground="{DynamicResource AudioLabChartLeft}" Text="— left" />
                    <Run Foreground="{DynamicResource AudioLabChartRight}" Text="  — right" />
                    <Run Text="  · the reference dashed in absolute mode · hover a point to read it" />
                </TextBlock>
                <TextBlock Margin="6,2,0,0" Foreground="{StaticResource AudioLabDimText}"
                           Visibility="{Binding IsThdMode, Converter={StaticResource VisibleWhen}}">
                    <Run Foreground="{DynamicResource AudioLabChartLeft}" Text="— left" />
                    <Run Foreground="{DynamicResource AudioLabChartRight}" Text="  — right" />
                    <Run Text="  · dBFS, a sine's peak per point · 1 the fundamental, 2 to 10 its harmonics · hover to read" />
                </TextBlock>
                <TextBlock Margin="6,2,0,0" Foreground="{StaticResource AudioLabDimText}"
                           Visibility="{Binding IsSpectrumMode, Converter={StaticResource VisibleWhen}}">
                    <Run Foreground="{DynamicResource AudioLabChartLeft}" Text="— left" />
                    <Run Foreground="{DynamicResource AudioLabChartRight}" Text="  — right" />
                    <Run Text="  · dBFS, a sine's peak per point · 1 to 5 the strongest peaks · hover to read" />
                </TextBlock>
                <StackPanel Visibility="{Binding IsResponseMode, Converter={StaticResource VisibleWhen}}">
                <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,4,0,0">
                    <DockPanel>
                        <TextBlock Style="{StaticResource HintStyle}" Text="Wheel over a digit, or click its upper or lower half" />
                        <TextBlock Style="{StaticResource AudioLabHeaderStyle}" Text="Sweep" />
                    </DockPanel>
                </Border>
                <UniformGrid Columns="4" Margin="2,0,2,0">
                    <StackPanel Margin="0,0,6,0">
                        <controls:LabDisplay Title="Start" TitleFontSize="13" DisplayBackground="{StaticResource AudioLabFrequencyBackground}">
                            <controls:LabDisplay.Body>
                                <controls:DigitDial IntegerDigits="5" FractionDigits="2" DigitFontSize="22" Minimum="20" Maximum="20000"
                                                    Value="{Binding Start.DialValue}" />
                            </controls:LabDisplay.Body>
                        </controls:LabDisplay>
                        <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="-- Hz --" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,0">
                        <controls:LabDisplay Title="Stop" TitleFontSize="13" DisplayBackground="{StaticResource AudioLabFrequencyBackground}">
                            <controls:LabDisplay.Body>
                                <controls:DigitDial IntegerDigits="5" FractionDigits="2" DigitFontSize="22" Minimum="20" Maximum="20000"
                                                    Value="{Binding Stop.DialValue}" />
                            </controls:LabDisplay.Body>
                        </controls:LabDisplay>
                        <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="-- Hz --" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,0">
                        <controls:LabDisplay Title="Points / decade" TitleFontSize="13" DisplayBackground="{StaticResource AudioLabAmplitudeBackground}">
                            <controls:LabDisplay.Body>
                                <controls:DigitDial IntegerDigits="2" FractionDigits="0" DigitFontSize="22" Minimum="1" Maximum="40"
                                                    Value="{Binding PointsPerDecade.DialValue}" />
                            </controls:LabDisplay.Body>
                        </controls:LabDisplay>
                        <TextBlock x:Name="PlanText" Style="{StaticResource AudioLabUnitLineStyle}" Text="{Binding PlanText}" />
                    </StackPanel>
                    <StackPanel>
                        <controls:LabDisplay Title="Output level" TitleFontSize="13" Marker="P2"
                                             DisplayBackground="{StaticResource AudioLabAmplitudeBackground}"
                                             IsMarked="{Binding Level.IsChangedOnBoard}">
                            <controls:LabDisplay.Body>
                                <controls:DigitDial IntegerDigits="2" FractionDigits="2" ShowSign="True" DigitFontSize="22"
                                                    Minimum="-60" Maximum="0" Value="{Binding Level.DialValue}" />
                            </controls:LabDisplay.Body>
                        </controls:LabDisplay>
                        <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="-- dBFS --" />
                    </StackPanel>
                </UniformGrid>
                <Border Style="{StaticResource AudioLabSettingsBlockStyle}" Margin="2,2,2,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ReferenceConfirmation" VerticalAlignment="Center" Margin="10,0,6,0"
                                      Content="Replace the reference" IsChecked="{Binding IsReferenceConfirmed}" />
                            <Button x:Name="KeepReferenceKey" Style="{StaticResource AudioLabGoldKeyStyle}" Height="30"
                                    Content="Keep as reference" Command="{Binding KeepReferenceCommand}" />
                        </StackPanel>
                        <Button x:Name="StartSweepKey" DockPanel.Dock="Left" Style="{StaticResource AudioLabKeyStyle}" Height="30"
                                FontWeight="Bold" Content="Start sweep" Command="{Binding StartSweepCommand}" />
                        <Button x:Name="StopSweepKey" DockPanel.Dock="Left" Style="{StaticResource AudioLabKeyStyle}" Height="30"
                                Content="Stop" Command="{Binding StopSweepCommand}" />
                        <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource AudioLabTextOnBlock}" MinWidth="110" Text="{Binding ProgressText}" />
                        <ProgressBar x:Name="SweepProgress" Height="14" Margin="8,0,0,0" Minimum="0" Maximum="1"
                                     Value="{Binding Progress, Mode=OneWay}" />
                    </DockPanel>
                </Border>
                </StackPanel>
                <StackPanel x:Name="DistortionBlock" Visibility="{Binding IsThdMode, Converter={StaticResource VisibleWhen}}">
                    <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock Style="{StaticResource HintStyle}" Text="The tone on K3/K4 against what returns on K2, about every 1.6 s" />
                            <TextBlock Style="{StaticResource AudioLabHeaderStyle}" Text="THD" />
                        </DockPanel>
                    </Border>
                    <UniformGrid Columns="4" Margin="2,0,2,0">
                        <StackPanel Margin="0,0,6,0">
                            <controls:LabDisplay x:Name="ThdLeftDisplay" Title="THD left" TitleFontSize="13"
                                                 DisplayBackground="{StaticResource AudioLabAmplitudeBackground}">
                                <controls:LabDisplay.Body>
                                    <TextBlock Text="{Binding ThdLeftText}" Foreground="{DynamicResource AudioLabDisplayValue}" FontSize="22" />
                                </controls:LabDisplay.Body>
                            </controls:LabDisplay>
                            <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="{Binding ThdLeftDecibelText, StringFormat='%  ·  {0}'}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <controls:LabDisplay x:Name="ThdnLeftDisplay" Title="THD+N left" TitleFontSize="13"
                                                 DisplayBackground="{StaticResource AudioLabAmplitudeBackground}">
                                <controls:LabDisplay.Body>
                                    <TextBlock Text="{Binding ThdnLeftText}" Foreground="{DynamicResource AudioLabDisplayValue}" FontSize="22" />
                                </controls:LabDisplay.Body>
                            </controls:LabDisplay>
                            <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="{Binding ThdnLeftDecibelText, StringFormat='%  ·  {0}'}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <controls:LabDisplay x:Name="ThdRightDisplay" Title="THD right" TitleFontSize="13"
                                                 DisplayBackground="{StaticResource AudioLabAmplitudeBackground}">
                                <controls:LabDisplay.Body>
                                    <TextBlock Text="{Binding ThdRightText}" Foreground="{DynamicResource AudioLabDisplayValue}" FontSize="22" />
                                </controls:LabDisplay.Body>
                            </controls:LabDisplay>
                            <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="{Binding ThdRightDecibelText, StringFormat='%  ·  {0}'}" />
                        </StackPanel>
                        <StackPanel>
                            <controls:LabDisplay x:Name="ThdnRightDisplay" Title="THD+N right" TitleFontSize="13"
                                                 DisplayBackground="{StaticResource AudioLabAmplitudeBackground}">
                                <controls:LabDisplay.Body>
                                    <TextBlock Text="{Binding ThdnRightText}" Foreground="{DynamicResource AudioLabDisplayValue}" FontSize="22" />
                                </controls:LabDisplay.Body>
                            </controls:LabDisplay>
                            <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="{Binding ThdnRightDecibelText, StringFormat='%  ·  {0}'}" />
                        </StackPanel>
                    </UniformGrid>
                    <Border Style="{StaticResource AudioLabSettingsBlockStyle}" Margin="2,2,2,0">
                        <DockPanel>
                            <Button x:Name="StartDistortionKey" DockPanel.Dock="Left" Style="{StaticResource AudioLabKeyStyle}" Height="30"
                                    FontWeight="Bold" Content="Start measuring" Command="{Binding StartDistortionCommand}" />
                            <Button x:Name="StopDistortionKey" DockPanel.Dock="Left" Style="{StaticResource AudioLabKeyStyle}" Height="30"
                                    Content="Stop" Command="{Binding StopDistortionCommand}" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HarmonicsLeft" Foreground="{DynamicResource AudioLabChartLeft}" TextTrimming="CharacterEllipsis"
                                           Text="{Binding HarmonicsLeftText}" />
                                <TextBlock x:Name="HarmonicsRight" Foreground="{DynamicResource AudioLabChartRight}" TextTrimming="CharacterEllipsis"
                                           Text="{Binding HarmonicsRightText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="SpectrumBlock" Visibility="{Binding IsSpectrumMode, Converter={StaticResource VisibleWhen}}">
                    <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock Style="{StaticResource HintStyle}" Text="What comes on K2, no tone of its own, about every 1.6 s" />
                            <TextBlock Style="{StaticResource AudioLabHeaderStyle}" Text="Spectrum" />
                        </DockPanel>
                    </Border>
                    <UniformGrid Columns="4" Margin="2,0,2,0">
                        <StackPanel Margin="0,0,6,0">
                            <controls:LabDisplay x:Name="RmsLeftDisplay" Title="RMS left" TitleFontSize="13"
                                                 DisplayBackground="{StaticResource AudioLabAmplitudeBackground}">
                                <controls:LabDisplay.Body>
                                    <TextBlock Text="{Binding RmsLeftText}" Foreground="{DynamicResource AudioLabDisplayValue}" FontSize="22" />
                                </controls:LabDisplay.Body>
                            </controls:LabDisplay>
                            <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="-- dBFS, 20 Hz to 20 kHz --" />
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <controls:LabDisplay x:Name="PeakLeftDisplay" Title="Strongest left" TitleFontSize="13"
                                                 DisplayBackground="{StaticResource AudioLabFrequencyBackground}">
                                <controls:LabDisplay.Body>
                                    <TextBlock Text="{Binding PeakLeftText}" Foreground="{DynamicResource AudioLabDisplayValue}" FontSize="22" />
                                </controls:LabDisplay.Body>
                            </controls:LabDisplay>
                            <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="{Binding PeakLeftLevelText, StringFormat='Hz  ·  {0}'}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <controls:LabDisplay x:Name="RmsRightDisplay" Title="RMS right" TitleFontSize="13"
                                                 DisplayBackground="{StaticResource AudioLabAmplitudeBackground}">
                                <controls:LabDisplay.Body>
                                    <TextBlock Text="{Binding RmsRightText}" Foreground="{DynamicResource AudioLabDisplayValue}" FontSize="22" />
                                </controls:LabDisplay.Body>
                            </controls:LabDisplay>
                            <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="-- dBFS, 20 Hz to 20 kHz --" />
                        </StackPanel>
                        <StackPanel>
                            <controls:LabDisplay x:Name="PeakRightDisplay" Title="Strongest right" TitleFontSize="13"
                                                 DisplayBackground="{StaticResource AudioLabFrequencyBackground}">
                                <controls:LabDisplay.Body>
                                    <TextBlock Text="{Binding PeakRightText}" Foreground="{DynamicResource AudioLabDisplayValue}" FontSize="22" />
                                </controls:LabDisplay.Body>
                            </controls:LabDisplay>
                            <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="{Binding PeakRightLevelText, StringFormat='Hz  ·  {0}'}" />
                        </StackPanel>
                    </UniformGrid>
                    <Border Style="{StaticResource AudioLabSettingsBlockStyle}" Margin="2,2,2,0">
                        <DockPanel>
                            <Button x:Name="StartSpectrumKey" DockPanel.Dock="Left" Style="{StaticResource AudioLabKeyStyle}" Height="30"
                                    FontWeight="Bold" Content="Start measuring" Command="{Binding StartSpectrumCommand}" />
                            <Button x:Name="StopSpectrumKey" DockPanel.Dock="Left" Style="{StaticResource AudioLabKeyStyle}" Height="30"
                                    Content="Stop" Command="{Binding StopSpectrumCommand}" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PeaksLeft" Foreground="{DynamicResource AudioLabChartLeft}" TextTrimming="CharacterEllipsis"
                                           Text="{Binding PeaksLeftText}" />
                                <TextBlock x:Name="PeaksRight" Foreground="{DynamicResource AudioLabChartRight}" TextTrimming="CharacterEllipsis"
                                           Text="{Binding PeaksRightText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
                <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,4,0,0">
                    <DockPanel>
                        <TextBlock Style="{StaticResource HintStyle}" Text="Input measured between sweeps" />
                        <TextBlock Style="{StaticResource AudioLabHeaderStyle}" Text="Tone and input" />
                    </DockPanel>
                </Border>
                <Grid Margin="2,0,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <controls:LabDisplay Title="Tone" TitleFontSize="13" DisplayBackground="{StaticResource AudioLabFrequencyBackground}">
                            <controls:LabDisplay.Body>
                                <controls:DigitDial IntegerDigits="5" FractionDigits="2" DigitFontSize="22" Minimum="20" Maximum="20000"
                                                    Value="{Binding Tone.DialValue}" />
                            </controls:LabDisplay.Body>
                        </controls:LabDisplay>
                        <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="-- Hz --" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <controls:LabDisplay x:Name="InputLeftDisplay" Title="Input left" TitleFontSize="13"
                                             DisplayBackground="{StaticResource AudioLabAmplitudeBackground}">
                            <controls:LabDisplay.Body>
                                <TextBlock Text="{Binding InputLeftText}" Foreground="{DynamicResource AudioLabDisplayValue}" FontSize="22" />
                            </controls:LabDisplay.Body>
                        </controls:LabDisplay>
                        <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="-- dBFS --" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <controls:LabDisplay x:Name="InputRightDisplay" Title="Input right" TitleFontSize="13"
                                             DisplayBackground="{StaticResource AudioLabAmplitudeBackground}">
                            <controls:LabDisplay.Body>
                                <TextBlock Text="{Binding InputRightText}" Foreground="{DynamicResource AudioLabDisplayValue}" FontSize="22" />
                            </controls:LabDisplay.Body>
                        </controls:LabDisplay>
                        <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="-- dBFS --" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource AudioLabSettingsBlockStyle}" Margin="2,2,2,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource AudioLabSettingsLabelStyle}" Text="Output" />
                        <ToggleButton x:Name="AnalyzerOutputKey" Style="{StaticResource AudioLabToggleStyle}"
                                      Width="130" Height="34" FontSize="13" FontWeight="Bold"
                                      Content="{Binding Output.OnOffText}"
                                      IsChecked="{Binding Output.IsOn, Mode=OneWay}"
                                      Command="{Binding Output.ToggleCommand}" />
                        <TextBlock Style="{StaticResource AudioLabSettingsLabelStyle}" Margin="12,0,0,0"
                                   Text="K3 and K4 out, K2 in · off after every start, on with every sweep" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- SigmaStudio page -->
            <StackPanel x:Name="SigmaStudioPage" IsEnabled="{Binding IsSigmaStudioRunning}"
                        Visibility="{Binding IsSigmaStudioSelected, Converter={StaticResource VisibleWhen}}">
                <Border Style="{StaticResource AudioLabSettingsBlockStyle}" Margin="2,0,2,0">
                    <StackPanel Margin="2,2">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AudioLabTextOnBlock}" Margin="0,1"
                                   Text="The DSP runs the program in its EEPROM: what SigmaStudio wrote there last." />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AudioLabTextOnBlock}" Margin="0,1"
                                   Text="The board supplies the 48 kHz clock and stays off the I2C bus: download and write the EEPROM with the USBi at any time, no service mode needed." />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AudioLabTextOnBlock}" Margin="0,1" Text="{Binding BackupText}" />
                    </StackPanel>
                </Border>
                <TextBlock Margin="6,6,0,2" Foreground="{StaticResource AudioLabDimText}"
                           Text="Pots to the DSP's auxiliary ADC · always passed on, every 20 ms" />
                <ItemsControl x:Name="AuxInputs" ItemsSource="{Binding Potentiometers}" Margin="2,0,2,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,6,0">
                                <controls:LabDisplay TitleFontSize="13" DisplayBackground="{StaticResource AudioLabAmplitudeBackground}">
                                    <controls:LabDisplay.Title>
                                        <MultiBinding StringFormat="{}{0} → {1}">
                                            <Binding Path="Name" />
                                            <Binding Path="Role" />
                                        </MultiBinding>
                                    </controls:LabDisplay.Title>
                                    <controls:LabDisplay.Body>
                                        <TextBlock Text="{Binding PercentText}" Foreground="{DynamicResource AudioLabDisplayValue}" FontSize="22" />
                                    </controls:LabDisplay.Body>
                                </controls:LabDisplay>
                                <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="{Binding AuxPin}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Margin="2,6,2,0" Padding="10,6" Background="{DynamicResource AudioLabNoteBackground}" BorderBrush="{DynamicResource AudioLabNoteBorder}" BorderThickness="4,0,0,0">
                    <TextBlock x:Name="SigmaStudioWarning" TextWrapping="Wrap" Foreground="{DynamicResource AudioLabNoteText}"
                               Text="Selecting another application writes its program to the EEPROM. The board keeps a copy of yours in its flash and writes it back when you return to this mode. Unplug the USBi before you switch." />
                </Border>
            </StackPanel>

            <!-- Synthesizer page -->
            <StackPanel x:Name="SynthPage" DataContext="{Binding Synth}" IsEnabled="{Binding IsRunning}"
                        Visibility="{Binding DataContext.IsSynthSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                <Grid Margin="2,0,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:LabDisplay x:Name="SynthNoteDisplay" Grid.Column="0" Title="Note" TitleFontSize="14"
                                         DisplayBackground="{StaticResource AudioLabFrequencyBackground}">
                        <controls:LabDisplay.Body>
                            <TextBlock Text="{Binding NoteText}" Foreground="{DynamicResource AudioLabDisplayValue}" FontSize="26"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </controls:LabDisplay.Body>
                    </controls:LabDisplay>
                    <controls:LabDisplay x:Name="SynthVolumeDisplay" Grid.Column="2" Title="Volume" Marker="P4"
                                         TitleFontSize="14" MarkerFontSize="10"
                                         DisplayBackground="{StaticResource AudioLabAmplitudeBackground}"
                                         IsMarked="{Binding Volume.IsChangedOnBoard}">
                        <controls:LabDisplay.Body>
                            <controls:DigitDial IntegerDigits="2" FractionDigits="2" ShowSign="True" DigitFontSize="26"
                                                Minimum="-60" Maximum="0" Value="{Binding Volume.DialValue}" />
                        </controls:LabDisplay.Body>
                    </controls:LabDisplay>
                    <Border Grid.Column="4" Style="{StaticResource AudioLabSettingsBlockStyle}" Margin="0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource AudioLabSettingsLabelStyle}" HorizontalAlignment="Center" Text="Output" />
                            <ToggleButton x:Name="SynthOutputKey" Style="{StaticResource AudioLabToggleStyle}"
                                          Width="120" Height="26" Margin="0,2,0,0" FontWeight="Bold"
                                          ToolTip="K3 and K4 · off after every start"
                                          Content="{Binding Output.OnOffText}"
                                          IsChecked="{Binding Output.IsOn, Mode=OneWay}"
                                          Command="{Binding Output.ToggleCommand}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SynthUnitLineStyle}"
                               Text="-- from the MIDI input K5 · 60 = C4 --" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SynthUnitLineStyle}" Text="-- dB --" />
                </Grid>

                <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,2,0,0">
                    <DockPanel>
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="P1 plays oscillator 1's width · the shape dial shows for rectangle and triangle" />
                        <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="Oscillators" />
                    </DockPanel>
                </Border>
                <ItemsControl x:Name="SynthOscillators" ItemsSource="{Binding Oscillators}" Margin="2,0,2,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Foreground="{DynamicResource AudioLabText}" FontWeight="Bold" Text="{Binding Title}" />
                                <ContentControl Content="{Binding Waveform}" ContentTemplate="{StaticResource ChoiceKeys}" />
                                <UniformGrid Columns="4">
                                    <ContentControl Content="{Binding Octave}" ContentTemplate="{StaticResource SmallDial}" />
                                    <ContentControl Content="{Binding Detune}" ContentTemplate="{StaticResource SmallDial}"
                                                    Visibility="{Binding HasDetune, Converter={StaticResource VisibleWhen}}" />
                                    <ContentControl Content="{Binding Level}" ContentTemplate="{StaticResource SmallDial}" />
                                    <ContentControl Content="{Binding Shape}" ContentTemplate="{StaticResource SmallDial}"
                                                    Visibility="{Binding HasShape, Converter={StaticResource VisibleWhen}}" />
                                </UniformGrid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,2,0,0">
                    <DockPanel>
                        <TextBlock Style="{StaticResource HintStyle}" Text="Ladder low-pass, 24 dB/octave, at middle C · dashed: at the contour's peak" />
                        <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="Filter" />
                    </DockPanel>
                </Border>
                <Grid Margin="2,0,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="262" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl x:Name="SynthFilter" ItemsSource="{Binding Filter}" ItemTemplate="{StaticResource SmallDial}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border Grid.Column="1" Height="112" VerticalAlignment="Top" Margin="0,2,0,0"
                            BorderBrush="{StaticResource AudioLabSeparator}" BorderThickness="1">
                        <controls:ResponseCurve x:Name="SynthFilterCurve" TopDecibel="24" BottomDecibel="-48" DecibelStep="24" CompactLabels="True"
                                                Response="{Binding FilterResponse}" SecondaryResponse="{Binding ContourResponse}" />
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,2,0,0">
                            <DockPanel>
                                <TextBlock Style="{StaticResource HintStyle}" Text="Pitch bend, velocity, glide" />
                                <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="Performance" />
                            </DockPanel>
                        </Border>
                        <ItemsControl x:Name="SynthPerformance" ItemsSource="{Binding Performance}" Margin="2,0,2,0" ItemTemplate="{StaticResource SmallDial}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="Mixer and MIDI" />
                        </Border>
                        <UniformGrid Columns="2" Margin="2,0,2,0">
                            <ContentControl x:Name="SynthNoise" Content="{Binding Noise}" ContentTemplate="{StaticResource SmallDial}" />
                            <ContentControl x:Name="SynthChannel" Content="{Binding Channel}" ContentTemplate="{StaticResource SmallDial}" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,2,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0">
                            <TextBlock Foreground="{StaticResource AudioLabDimText}" Margin="0,0,6,0" Text="Mod wheel" />
                            <TextBlock x:Name="SynthModStripText" Foreground="{DynamicResource AudioLabText}" FontWeight="Bold" Text="{Binding ModStripText}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="LFOs" />
                    </DockPanel>
                </Border>
                <ItemsControl x:Name="SynthLfos" ItemsSource="{Binding Lfos}" Margin="2,0,2,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Foreground="{DynamicResource AudioLabText}" FontWeight="Bold" Text="{Binding Title}" />
                                <ContentControl Content="{Binding Waveform}" ContentTemplate="{StaticResource ChoiceKeys}" />
                                <UniformGrid Columns="4">
                                    <ContentControl Content="{Binding Rate}" ContentTemplate="{StaticResource SmallDial}" />
                                    <ContentControl Content="{Binding Depth}" ContentTemplate="{StaticResource SmallDial}" />
                                    <ContentControl Content="{Binding Shape}" ContentTemplate="{StaticResource SmallDial}"
                                                    Visibility="{Binding HasShape, Converter={StaticResource VisibleWhen}}" />
                                    <ContentControl Content="{Binding FilterDepth}" ContentTemplate="{StaticResource SmallDial}"
                                                    Visibility="{Binding HasFilterDepth, Converter={StaticResource VisibleWhen}}" />
                                    <ContentControl Content="{Binding PwmDepth}" ContentTemplate="{StaticResource SmallDial}"
                                                    Visibility="{Binding HasPwmDepth, Converter={StaticResource VisibleWhen}}" />
                                </UniformGrid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,2,0,0">
                            <DockPanel>
                                <TextBlock Style="{StaticResource HintStyle}" Text="Single trigger: legato notes do not restart it" />
                                <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="Envelope" />
                            </DockPanel>
                        </Border>
                        <ItemsControl x:Name="SynthEnvelope" ItemsSource="{Binding Envelope}" Margin="2,0,2,0" ItemTemplate="{StaticResource SmallDial}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <Border Grid.Column="1" Margin="2,6,2,14" BorderBrush="{StaticResource AudioLabSeparator}" BorderThickness="1">
                        <controls:EnvelopeGraph x:Name="SynthEnvelopeGraph" Envelopes="{Binding Envelopes}" />
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Receiver page: three views, as the analysis page has its parts -->
            <StackPanel x:Name="ReceiverPage" DataContext="{Binding Receiver}" IsEnabled="{Binding IsRunning}"
                        Visibility="{Binding DataContext.IsReceiverSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}">
                <DockPanel Margin="6,0,6,2">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Foreground="{StaticResource AudioLabDimText}" VerticalAlignment="Center" Margin="0,0,8,0" Text="Show" />
                        <RadioButton x:Name="ReceiverViewChoice" GroupName="ReceiverView" Foreground="{DynamicResource AudioLabText}" VerticalContentAlignment="Center"
                                     Margin="0,0,10,0" Content="Receiver" FontWeight="Bold"
                                     IsChecked="{Binding IsReceiverView, Mode=OneWay}"
                                     Command="{Binding ShowViewCommand}" CommandParameter="receiver" />
                        <RadioButton x:Name="FilterViewChoice" GroupName="ReceiverView" Foreground="{DynamicResource AudioLabText}" VerticalContentAlignment="Center"
                                     Margin="0,0,10,0" Content="Filter" FontWeight="Bold"
                                     IsChecked="{Binding IsFilterView, Mode=OneWay}"
                                     Command="{Binding ShowViewCommand}" CommandParameter="filter" />
                        <RadioButton x:Name="DesignerViewChoice" GroupName="ReceiverView" Foreground="{DynamicResource AudioLabText}" VerticalContentAlignment="Center"
                                     Content="Designer" FontWeight="Bold"
                                     IsChecked="{Binding IsDesignerView, Mode=OneWay}"
                                     Command="{Binding ShowViewCommand}" CommandParameter="designer" />
                    </StackPanel>
                    <TextBlock x:Name="ReceiverFilterState" Foreground="{StaticResource AudioLabDimText}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Text="{Binding FilterStatusText}" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!-- ===== Receiver view ===== -->
                <StackPanel x:Name="ReceiverViewPanel" Visibility="{Binding IsReceiverView, Converter={StaticResource VisibleWhen}}">
                    <ContentControl x:Name="ReceiverModeKeys" Margin="2,0,0,2"
                                    Content="{Binding Mode}" ContentTemplate="{StaticResource ChoiceKeys}" />
                    <Grid Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="270" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <controls:LabDisplay x:Name="ReceiverDialDisplay" Title="{Binding DialTitle}" TitleFontSize="14"
                                                 DisplayBackground="{StaticResource AudioLabFrequencyBackground}">
                                <controls:LabDisplay.Body>
                                    <Grid>
                                        <controls:DigitDial IntegerDigits="8" FractionDigits="0" DigitFontSize="40"
                                                            Minimum="{Binding RfMinimum}" Maximum="{Binding RfMaximum}"
                                                            Value="{Binding RfDialValue}"
                                                            Visibility="{Binding IsRfDial, Converter={StaticResource VisibleWhen}}" />
                                        <controls:DigitDial IntegerDigits="5" FractionDigits="0" DigitFontSize="40"
                                                            ShowSign="True" ShowPlus="True" Minimum="-21000" Maximum="21000"
                                                            Value="{Binding Offset.DialValue}"
                                                            Visibility="{Binding IsOffsetDial, Converter={StaticResource VisibleWhen}}" />
                                    </Grid>
                                </controls:LabDisplay.Body>
                            </controls:LabDisplay>
                            <TextBlock Style="{StaticResource AudioLabUnitLineStyle}" Text="{Binding DialUnitLine}" />
                            <TextBlock x:Name="TuningText" Margin="4,0" Foreground="{StaticResource AudioLabDimText}"
                                       Text="{Binding TuningText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="BandText" Margin="4,0" Foreground="{StaticResource AudioLabWarningText}"
                                       Text="{Binding BandText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <controls:LabDisplay x:Name="SMeterDisplay" Title="S-meter" TitleFontSize="14"
                                                 DisplayBackground="{StaticResource AudioLabAmplitudeBackground}">
                                <controls:LabDisplay.Body>
                                    <StackPanel Width="236">
                                        <TextBlock Text="{Binding SMeterText}" Foreground="{DynamicResource AudioLabDisplayValue}"
                                                   FontSize="20" HorizontalAlignment="Right" />
                                        <controls:LevelBar Margin="0,2,0,0" Minimum="-130" Maximum="0" TickStep="20"
                                                           Value="{Binding SMeter}" Mark="{Binding SquelchMark}" />
                                    </StackPanel>
                                </controls:LabDisplay.Body>
                            </controls:LabDisplay>
                            <TextBlock x:Name="MeterText" Margin="4,2,4,0" Foreground="{StaticResource AudioLabDimText}" TextTrimming="CharacterEllipsis">
                                <Run Text="AGC" /> <Run Text="{Binding AgcGainText, Mode=OneWay}" Foreground="{DynamicResource AudioLabText}" />
                                <Run Text=" · audio" /> <Run Text="{Binding AudioText, Mode=OneWay}" Foreground="{DynamicResource AudioLabText}" />
                                <Run Text=" · CPU" /> <Run Text="{Binding CpuText, Mode=OneWay}" Foreground="{DynamicResource AudioLabText}" />
                            </TextBlock>
                            <TextBlock x:Name="SquelchText" Margin="4,0" Foreground="{StaticResource AudioLabDimText}" TextTrimming="CharacterEllipsis">
                                <Run Text="Squelch" /> <Run Text="{Binding SquelchText, Mode=OneWay}" Foreground="{DynamicResource AudioLabText}" />
                                <Run Text="  " /> <Run Text="{Binding FmOffsetText, Mode=OneWay}" />
                                <Run Text="  " /> <Run Text="{Binding NrGainText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,2,0,0">
                        <DockPanel>
                            <TextBlock Style="{StaticResource HintStyle}" Text="P1 sets the width · edit the edges on the Filter view" />
                            <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="Filter" />
                        </DockPanel>
                    </Border>
                    <Grid Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="270" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="ReceiverWidth" Grid.Column="0" Width="100" Content="{Binding Width}" ContentTemplate="{StaticResource SmallDial}" />
                        <ContentControl x:Name="ReceiverPitch" Grid.Column="1" Width="90" Content="{Binding Pitch}" ContentTemplate="{StaticResource SmallDial}"
                                        Visibility="{Binding IsCw, Converter={StaticResource VisibleWhen}}" />
                        <StackPanel Grid.Column="2" Margin="4,2,6,0">
                            <TextBlock x:Name="FilterSummary" Foreground="{DynamicResource AudioLabText}" TextWrapping="Wrap"
                                       Text="{Binding FilterSummaryText}" />
                            <TextBlock Foreground="{StaticResource AudioLabDimText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="{Binding DesignText}" />
                        </StackPanel>
                        <Border Grid.Column="3" Height="70" VerticalAlignment="Top" Margin="0,2,0,0"
                                BorderBrush="{StaticResource AudioLabSeparator}" BorderThickness="1">
                            <controls:FilterChart x:Name="FilterPreview" Compact="True" IsHitTestVisible="False"
                                                  Low="{Binding ChartLow}" High="{Binding ChartHigh}" StopDb="{Binding ChartStop}"
                                                  BottomDb="{Binding BottomDb}" Predicted="{Binding Predicted}" />
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,2,0,0">
                        <DockPanel>
                            <TextBlock Style="{StaticResource HintStyle}" Text="P2 sets the NR level, P3 the squelch" />
                            <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="AGC, noise reduction, squelch" />
                        </DockPanel>
                    </Border>
                    <Grid Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ContentControl x:Name="AgcKeys" Content="{Binding Agc}" ContentTemplate="{StaticResource ChoiceKeys}" />
                            <UniformGrid Columns="3">
                                <ContentControl Content="{Binding AgcGain}" ContentTemplate="{StaticResource SmallDial}" />
                                <ContentControl Content="{Binding Hang}" ContentTemplate="{StaticResource SmallDial}" />
                                <ContentControl Content="{Binding Decay}" ContentTemplate="{StaticResource SmallDial}" />
                            </UniformGrid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <ContentControl x:Name="NrKeys" Content="{Binding Nr}" ContentTemplate="{StaticResource ChoiceKeys}" />
                            <UniformGrid Columns="4">
                                <ContentControl Content="{Binding NrLevel}" ContentTemplate="{StaticResource SmallDial}" />
                                <ContentControl Content="{Binding Squelch}" ContentTemplate="{StaticResource SmallDial}" />
                                <ContentControl Content="{Binding FmDeviation}" ContentTemplate="{StaticResource SmallDial}"
                                                Visibility="{Binding IsFm, Converter={StaticResource VisibleWhen}}" />
                                <ContentControl Content="{Binding Deemphasis}" ContentTemplate="{StaticResource SmallDial}"
                                                Visibility="{Binding IsFm, Converter={StaticResource VisibleWhen}}" />
                            </UniformGrid>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,2,0,0">
                        <DockPanel>
                            <TextBlock Style="{StaticResource HintStyle}" Text="The SDR front end: the Uno with the Si5351A on its own port" />
                            <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="Input and front end" />
                        </DockPanel>
                    </Border>
                    <Grid Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="InputKeys" Grid.Column="0" VerticalAlignment="Center"
                                        Content="{Binding Input}" ContentTemplate="{StaticResource ChoiceKeys}" />
                        <ContentControl Grid.Column="1" Width="90" Content="{Binding IqGain}" ContentTemplate="{StaticResource SmallDial}" />
                        <ContentControl Grid.Column="2" Width="96" Content="{Binding IqPhase}" ContentTemplate="{StaticResource SmallDial}" />
                        <StackPanel Grid.Column="3" Margin="4,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="NullImageKey" Style="{StaticResource AudioLabKeyStyle}" FontWeight="Bold" Content="Null image"
                                        ToolTip="Finds the I/Q correction with a steady carrier tuned into the channel"
                                        Command="{Binding NullImageCommand}" />
                                <Button Style="{StaticResource AudioLabKeyStyle}" Content="Cancel" Command="{Binding CancelCommand}" />
                            </StackPanel>
                            <TextBlock x:Name="NullText" Margin="2,3,0,0" Foreground="{StaticResource AudioLabDimText}" TextWrapping="Wrap"
                                       Text="{Binding NullText}" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="FrontEndCard" Style="{StaticResource AudioLabSettingsBlockStyle}" Margin="2,2,2,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Style="{StaticResource AudioLabSettingsLabelStyle}" Text="Front end on" FontWeight="Bold" />
                                <ComboBox x:Name="FrontEndPortBox" Width="150" Height="24" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding FrontEndPorts}" SelectedItem="{Binding SelectedFrontEndPort}"
                                          IsEnabled="{Binding IsFrontEndDisconnected}" />
                                <Button Style="{StaticResource AudioLabKeyStyle}" MinWidth="28" Content="↻" ToolTip="Look for ports again"
                                        Command="{Binding RefreshFrontEndPortsCommand}" />
                                <Button x:Name="FrontEndConnectKey" Style="{StaticResource AudioLabGoldKeyStyle}" Content="Connect"
                                        Command="{Binding ConnectFrontEndCommand}" />
                                <Button x:Name="FrontEndDisconnectKey" Style="{StaticResource AudioLabKeyStyle}" Content="Disconnect"
                                        Command="{Binding DisconnectFrontEndCommand}" />
                                <TextBlock x:Name="FrontEndStatus" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AudioLabTextOnBlock}"
                                           FontWeight="Bold" Text="{Binding FrontEndStatusText}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0" LastChildFill="False" IsEnabled="{Binding IsFrontEndConnected}">
                                <TextBlock Style="{StaticResource AudioLabSettingsLabelStyle}" Text="LO drive" />
                                <ItemsControl x:Name="DriveKeys" ItemsSource="{Binding DriveKeys}" Width="230" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource AudioLabStationKeyStyle}" Height="22" Margin="0,0,3,0" Padding="2,0" FontSize="10"
                                                    Content="{Binding Label}" Command="{Binding SelectCommand}" CommandParameter="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource AudioLabSettingsLabelStyle}" Margin="12,0,4,0" Text="Correction" />
                                <TextBox x:Name="CorrectionBox" Width="70" Height="22" FontSize="12" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                         ToolTip="Crystal correction in ppb, -100000 to 100000; Enter sets it"
                                         Text="{Binding CorrectionText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SetCorrectionCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Style="{StaticResource AudioLabSettingsLabelStyle}" Margin="4,0" Text="ppb" />
                                <Button Style="{StaticResource AudioLabKeyStyle}" Height="22" Content="Set" Command="{Binding SetCorrectionCommand}" />
                            </DockPanel>
                            <TextBlock x:Name="FrontEndText" Margin="2,4,0,0" Foreground="{DynamicResource AudioLabTextOnBlock}"
                                       Text="{Binding FrontEndText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FrontEndText}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,2,0,0">
                        <DockPanel>
                            <TextBlock Style="{StaticResource HintStyle}" Text="As on the equalizer page · P4 sets the volume" />
                            <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="Equalizer" />
                        </DockPanel>
                    </Border>
                    <Grid Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl x:Name="ReceiverBands" ItemsSource="{Binding Bands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <UniformGrid Columns="2">
                                        <ContentControl Content="{Binding Gain}" ContentTemplate="{StaticResource SmallDial}" />
                                        <ContentControl Content="{Binding Frequency}" ContentTemplate="{StaticResource SmallDial}" />
                                    </UniformGrid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ContentControl x:Name="ReceiverVolume" Width="90" Content="{Binding Volume}" ContentTemplate="{StaticResource SmallDial}" />
                            <StackPanel VerticalAlignment="Center" Margin="2,0,0,10">
                                <ToggleButton x:Name="ReceiverOutputKey" Style="{StaticResource AudioLabToggleStyle}"
                                              Width="124" Height="30" FontWeight="Bold"
                                              ToolTip="K3 and K4 · off after every start"
                                              Content="{Binding Output.OnOffText}"
                                              IsChecked="{Binding Output.IsOn, Mode=OneWay}"
                                              Command="{Binding Output.ToggleCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- ===== Filter view ===== -->
                <StackPanel x:Name="FilterViewPanel" Visibility="{Binding IsFilterView, Converter={StaticResource VisibleWhen}}">
                    <Border Margin="2,0,2,0" BorderBrush="{StaticResource AudioLabSeparator}" BorderThickness="1">
                        <controls:FilterChart x:Name="FilterResponse" Height="250" IsEditable="True"
                                              Low="{Binding ChartLow}" High="{Binding ChartHigh}" StopDb="{Binding ChartStop}"
                                              BottomDb="{Binding BottomDb}" Predicted="{Binding Predicted}" Measured="{Binding Measured}"
                                              PredictedLabel="{Binding PredictedLabel}"
                                              EdgesCommand="{Binding SetEdgesCommand}" StopCommand="{Binding SetStopCommand}" />
                    </Border>
                    <TextBlock Margin="6,2,0,0" Foreground="{StaticResource AudioLabDimText}"
                               Text="Drag an edge, the passband or the dashed stop-band line; the receiver designs on release · hover to read" />
                    <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock Style="{StaticResource HintStyle}" Text="Edges re the carrier, at -6 dB" />
                            <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="Channel filter" />
                        </DockPanel>
                    </Border>
                    <UniformGrid Columns="5" Margin="2,0,2,0">
                        <ContentControl x:Name="FilterLow" Content="{Binding Low}" ContentTemplate="{StaticResource SmallDial}" />
                        <ContentControl x:Name="FilterHigh" Content="{Binding High}" ContentTemplate="{StaticResource SmallDial}" />
                        <ContentControl x:Name="FilterWidth" Content="{Binding Width}" ContentTemplate="{StaticResource SmallDial}" />
                        <ContentControl x:Name="FilterStop" Content="{Binding Stopband}" ContentTemplate="{StaticResource SmallDial}" />
                        <ContentControl x:Name="FilterPitch" Content="{Binding Pitch}" ContentTemplate="{StaticResource SmallDial}"
                                        IsEnabled="{Binding IsCw}" />
                    </UniformGrid>
                    <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource AudioLabText}" Text="{Binding EdgesText}" />
                    <TextBlock Margin="6,1,0,0" Foreground="{StaticResource AudioLabDimText}" Text="{Binding DesignText}" />

                    <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock Style="{StaticResource HintStyle}" Text="The test tone steps across the band; the S-meter reads it" />
                            <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="Measure" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource AudioLabSettingsBlockStyle}" Margin="2,0,2,0">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="MeasureFilterKey" DockPanel.Dock="Left" Style="{StaticResource AudioLabKeyStyle}" Height="30"
                                        FontWeight="Bold" Content="Measure" Command="{Binding MeasureCommand}" />
                                <Button DockPanel.Dock="Left" Style="{StaticResource AudioLabKeyStyle}" Height="30"
                                        Content="Cancel" Command="{Binding CancelCommand}" />
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AudioLabSettingsLabelStyle}" Margin="10,0,4,0" Text="Step" />
                                <ComboBox x:Name="SweepStepBox" DockPanel.Dock="Left" Width="64" Height="24" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding SweepSteps}" SelectedItem="{Binding SweepStep}" />
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource AudioLabSettingsLabelStyle}" Margin="4,0,0,0" Text="Hz" />
                                <ProgressBar x:Name="MeasureProgress" Height="14" Margin="10,0,0,0" Minimum="0" Maximum="1"
                                             Value="{Binding MeasureProgress, Mode=OneWay}" />
                            </DockPanel>
                            <TextBlock x:Name="MeasureText" Margin="2,4,0,0" Foreground="{DynamicResource AudioLabTextOnBlock}" TextWrapping="Wrap"
                                       Text="{Binding MeasureText}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock Style="{StaticResource HintStyle}" Text="Into the receiver's input, instead of the antenna" />
                            <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="Test tone" />
                        </DockPanel>
                    </Border>
                    <Grid Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="TestToneKey" Style="{StaticResource AudioLabToggleStyle}" VerticalAlignment="Center" Margin="2,0,10,14"
                                      Width="140" Height="30" FontWeight="Bold"
                                      Content="{Binding Test.OnOffText}" IsChecked="{Binding Test.IsOn, Mode=OneWay}"
                                      Command="{Binding Test.ToggleCommand}" />
                        <UniformGrid Grid.Column="1" Columns="4">
                            <ContentControl Content="{Binding TestOffset}" ContentTemplate="{StaticResource SmallDial}" />
                            <ContentControl Content="{Binding TestLevel}" ContentTemplate="{StaticResource SmallDial}" />
                            <ContentControl Content="{Binding TestNoise}" ContentTemplate="{StaticResource SmallDial}" />
                            <ContentControl Content="{Binding TestKey}" ContentTemplate="{StaticResource SmallDial}" />
                        </UniformGrid>
                    </Grid>
                </StackPanel>

                <!-- ===== Designer view ===== -->
                <StackPanel x:Name="DesignerViewPanel" Visibility="{Binding IsDesignerView, Converter={StaticResource VisibleWhen}}">
                    <Border Margin="2,0,2,0" BorderBrush="{StaticResource AudioLabSeparator}" BorderThickness="1">
                        <controls:FilterChart x:Name="DesignResponse" Height="220" ShowEdges="False"
                                              StopDb="{Binding DesignStop}" BottomDb="{Binding DesignBottomDb}"
                                              Predicted="{Binding DesignPredicted}" Mask="{Binding Mask}"
                                              PredictedLabel="designed here (with the down-converter)" />
                    </Border>
                    <TextBlock Margin="6,2,0,0" Foreground="{StaticResource AudioLabDimText}" TextTrimming="CharacterEllipsis"
                               Text="{Binding DesignSourceText}" />
                    <TextBlock x:Name="DesignProblem" Margin="6,0,0,0" Foreground="{StaticResource AudioLabWarningText}"
                               Text="{Binding DesignProblem}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="310" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,2,0,0">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource HintStyle}" Text="Hz re the carrier, edges at -6 dB" />
                                    <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="Mask" />
                                </DockPanel>
                            </Border>
                            <Grid Margin="6,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{StaticResource AudioLabDimText}" Text="From, Hz" />
                                <TextBlock Grid.Column="1" Foreground="{StaticResource AudioLabDimText}" Text="To, Hz" />
                                <TextBlock Grid.Column="2" Foreground="{StaticResource AudioLabDimText}" Text="Gain, dB" />
                            </Grid>
                            <ItemsControl x:Name="MaskRows" ItemsSource="{Binding MaskBands}" Margin="2,0,2,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Margin="0,0,4,0" Padding="4,1" Background="{StaticResource AudioLabFrequencyBackground}"
                                                    CornerRadius="{DynamicResource AudioLabDisplayCornerRadius}">
                                                <controls:DigitDial IntegerDigits="4" FractionDigits="0" ShowSign="True" DigitFontSize="16"
                                                                    Minimum="{Binding EdgeMinimum}" Maximum="{Binding EdgeMaximum}" Value="{Binding From}" />
                                            </Border>
                                            <Border Grid.Column="1" Margin="0,0,4,0" Padding="4,1" Background="{StaticResource AudioLabFrequencyBackground}"
                                                    CornerRadius="{DynamicResource AudioLabDisplayCornerRadius}">
                                                <controls:DigitDial IntegerDigits="4" FractionDigits="0" ShowSign="True" DigitFontSize="16"
                                                                    Minimum="{Binding EdgeMinimum}" Maximum="{Binding EdgeMaximum}" Value="{Binding To}" />
                                            </Border>
                                            <Border Grid.Column="2" Margin="0,0,4,0" Padding="4,1" Background="{StaticResource AudioLabAmplitudeBackground}"
                                                    CornerRadius="{DynamicResource AudioLabDisplayCornerRadius}">
                                                <controls:DigitDial IntegerDigits="2" FractionDigits="1" ShowSign="True" ShowPlus="True" DigitFontSize="16"
                                                                    Minimum="-60" Maximum="20" Value="{Binding GainDb}" />
                                            </Border>
                                            <Button Grid.Column="3" HorizontalAlignment="Left" Style="{StaticResource AudioLabKeyStyle}" MinWidth="26" Padding="4,0"
                                                    Content="✕" ToolTip="Remove this band" Command="{Binding RemoveCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="2,2,2,0">
                                <Button x:Name="AddBandKey" Style="{StaticResource AudioLabKeyStyle}" Margin="0,0,6,4" Content="Add band"
                                        Command="{Binding AddBandCommand}" />
                                <ItemsControl x:Name="TemplateKeys" ItemsSource="{Binding Templates}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource AudioLabKeyStyle}" Margin="0,0,4,4" Padding="6,0" Content="{Binding}"
                                                    ToolTip="Start from this mask"
                                                    Command="{Binding DataContext.TemplateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,2,0,0">
                                <TextBlock Style="{StaticResource SynthHeaderStyle}" Text="Design and download" />
                            </Border>
                            <UniformGrid Columns="2" Margin="2,0,2,0">
                                <StackPanel Margin="0,0,6,0">
                                    <controls:LabDisplay Title="Stop band" TitleFontSize="11" DisplayBackground="{StaticResource AudioLabAmplitudeBackground}">
                                        <controls:LabDisplay.Body>
                                            <controls:DigitDial IntegerDigits="3" FractionDigits="0" DigitFontSize="16" Minimum="20" Maximum="120"
                                                                Value="{Binding DesignStop}" />
                                        </controls:LabDisplay.Body>
                                    </controls:LabDisplay>
                                    <TextBlock Style="{StaticResource SynthUnitLineStyle}" Text="-- dB --" />
                                </StackPanel>
                                <StackPanel>
                                    <controls:LabDisplay Title="Transition" TitleFontSize="11" DisplayBackground="{StaticResource AudioLabFrequencyBackground}">
                                        <controls:LabDisplay.Body>
                                            <controls:DigitDial IntegerDigits="4" FractionDigits="0" DigitFontSize="16" Minimum="20" Maximum="1000"
                                                                Value="{Binding DesignTransition}" />
                                        </controls:LabDisplay.Body>
                                    </controls:LabDisplay>
                                    <TextBlock Style="{StaticResource SynthUnitLineStyle}" Text="-- Hz --" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="DesignInfo" Margin="4,0" Foreground="{DynamicResource AudioLabText}" Text="{Binding DesignInfoText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="DownloadFilterKey" Style="{StaticResource AudioLabGoldKeyStyle}" Content="Download"
                                        ToolTip="Sends the coefficients to the receiver and switches them in"
                                        Command="{Binding DownloadCommand}" />
                                <Button x:Name="DesignAgainKey" Style="{StaticResource AudioLabKeyStyle}" Content="Design again"
                                        ToolTip="Back to the filter the receiver designs from its edges"
                                        Command="{Binding DesignAgainCommand}" />
                                <Button Style="{StaticResource AudioLabKeyStyle}" Content="Cancel" Command="{Binding CancelCommand}" />
                            </StackPanel>
                            <ProgressBar x:Name="DownloadProgress" Height="10" Margin="2,4,2,0" Minimum="0" Maximum="1"
                                         Value="{Binding DownloadProgress, Mode=OneWay}" />
                            <TextBlock Margin="4,2,4,0" Foreground="{StaticResource AudioLabDimText}" TextWrapping="Wrap"
                                       Text="{Binding DesignerBoardText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="ImportKey" Style="{StaticResource AudioLabKeyStyle}" Content="Import CSV …" Click="ImportCoefficients_Click" />
                                <Button x:Name="ExportKey" Style="{StaticResource AudioLabKeyStyle}" Content="Export CSV …" Click="ExportCoefficients_Click"
                                        IsEnabled="{Binding HasCoefficients}" />
                                <Button Style="{StaticResource AudioLabKeyStyle}" Content="Use the mask" Command="{Binding UseMaskCommand}" />
                            </StackPanel>
                            <TextBlock Margin="4,8,4,0" Foreground="{StaticResource AudioLabDimText}" Text="Designs kept on this PC: a name, then Save" />
                            <DockPanel Margin="2,2,2,0">
                                <Button x:Name="SaveDesignKey" DockPanel.Dock="Right" Style="{StaticResource AudioLabKeyStyle}" Content="Save"
                                        Command="{Binding SaveDesignCommand}" />
                                <TextBox x:Name="DesignNameBox" Height="24" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,2,0"
                                         ToolTip="{Binding DesignsDirectory}"
                                         Text="{Binding DesignName, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SaveDesignCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <DockPanel Margin="2,4,2,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource AudioLabKeyStyle}" Content="Delete" Command="{Binding DeleteDesignCommand}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource AudioLabKeyStyle}" Content="Load" Command="{Binding LoadDesignCommand}" />
                                <ComboBox x:Name="DesignsBox" Height="24" VerticalContentAlignment="Center" Margin="0,0,2,0"
                                          ItemsSource="{Binding Designs}" SelectedItem="{Binding SelectedDesign}" />
                            </DockPanel>
                            <TextBlock x:Name="DesignerMessage" Margin="4,3,4,0" Foreground="{StaticResource AudioLabDimText}" TextWrapping="Wrap"
                                       Text="{Binding DesignerMessage}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Potentiometers -->
            <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,4,0,0">
                <TextBlock Style="{StaticResource AudioLabHeaderStyle}" Text="Potentiometers" />
            </Border>
            <DockPanel Margin="4,0,4,4">
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,6,0">
                    <ToggleButton x:Name="PotControlKey" Style="{StaticResource AudioLabToggleStyle}"
                                  Width="130" Content="{Binding PotentiometerControlText}"
                                  IsChecked="{Binding IsPotentiometerControlOn, Mode=OneWay}"
                                  Command="{Binding TogglePotentiometerControlCommand}" />
                    <TextBlock Style="{StaticResource AudioLabInfoStyle}" Margin="0,4,0,0" HorizontalAlignment="Center"
                               Text="Off at every power-up" />
                </StackPanel>
                <ItemsControl x:Name="PotStrip" ItemsSource="{Binding Potentiometers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:PotKnob Label="{Binding Name}" Role="{Binding Role}"
                                              Angle="{Binding Angle}" IsAssigned="{Binding IsDriving}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </StackPanel>

        <!-- ============ Right: board, power-up, service, settings ============ -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource AudioLabSeparator}" BorderThickness="1,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource AudioLabHeaderStyle}" Text="Board" />
                    <TextBlock Style="{StaticResource AudioLabInfoStyle}">
                        <Run Text="Firmware:" /> <Run Text="{Binding FirmwareText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource AudioLabInfoStyle}">
                        <Run Text="Application:" /> <Run Text="{Binding ActiveApplicationDisplayName, Mode=OneWay}" />
                    </TextBlock>
                    <Button x:Name="BoardWifiKey" Style="{StaticResource AudioLabKeyStyle}" Margin="6,6,6,2" HorizontalAlignment="Left"
                            Content="WiFi networks …" ToolTip="The networks the radio uses, kept on the board"
                            IsEnabled="{Binding IsConnected}" Click="Wifi_Click" />

                    <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource AudioLabHeaderStyle}" Text="Power-up" />
                    </Border>
                    <TextBlock Style="{StaticResource AudioLabInfoStyle}"
                               Text="What the board starts when switched on. The last application starts with its defaults; the radio and the synthesizer sound." />
                    <ToggleButton x:Name="StartupKey" Style="{StaticResource AudioLabToggleStyle}"
                                  Width="150" Margin="6,6,6,2" HorizontalAlignment="Left"
                                  Content="{Binding StartupText}"
                                  IsChecked="{Binding IsStartupRestoring, Mode=OneWay}"
                                  Command="{Binding ToggleStartupCommand}" />

                    <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource AudioLabHeaderStyle}" Text="Service" />
                    </Border>
                    <TextBlock Style="{StaticResource AudioLabInfoStyle}"
                               Text="Hands the DSP to SigmaStudio and the USBi. Leaving restores the application." />
                    <CheckBox x:Name="ServiceConfirmation" Margin="8,6,8,4" Foreground="{DynamicResource AudioLabText}"
                              Content="Hand the DSP to SigmaStudio"
                              IsChecked="{Binding IsServiceConfirmed}" IsEnabled="{Binding CanSelectApplication}" />
                    <StackPanel Orientation="Horizontal" Margin="6,2">
                        <Button x:Name="EnterServiceKey" Style="{StaticResource AudioLabGoldKeyStyle}"
                                Content="Enter service" Command="{Binding EnterServiceCommand}" />
                        <Button x:Name="LeaveServiceKey" Style="{StaticResource AudioLabKeyStyle}"
                                Content="Leave service" Command="{Binding LeaveServiceCommand}" />
                    </StackPanel>

                    <Border Style="{StaticResource AudioLabHeaderRuleStyle}" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource AudioLabHeaderStyle}" Text="Settings" />
                    </Border>
                    <TextBlock Style="{StaticResource AudioLabInfoStyle}"
                               Text="The running application and its values, stored on this PC; applying never switches an output on." />
                    <DockPanel Margin="6,6,6,2">
                        <Button x:Name="SaveSettingsKey" DockPanel.Dock="Right" Style="{StaticResource AudioLabKeyStyle}"
                                Content="Save" Command="{Binding SaveSettingsCommand}" />
                        <TextBox x:Name="SettingsNameBox" Height="24" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,4,0"
                                 ToolTip="The name to store the settings under; a file name, no path."
                                 Text="{Binding SettingsName, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SaveSettingsCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,2,6,4">
                        <Button x:Name="ApplySettingsKey" Style="{StaticResource AudioLabGoldKeyStyle}" MinWidth="70"
                                Content="Apply" Command="{Binding ApplySettingsCommand}" />
                        <Button x:Name="DeleteSettingsKey" Style="{StaticResource AudioLabKeyStyle}" MinWidth="70"
                                Content="Delete" Command="{Binding DeleteSettingsCommand}" />
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="SettingsList" Margin="6,0,6,6" MinHeight="60"
                         Background="{DynamicResource AudioLabListBackground}" Foreground="{DynamicResource AudioLabListText}" FontSize="12"
                         BorderBrush="{StaticResource AudioLabSeparator}"
                         ItemsSource="{Binding SettingsNames}"
                         SelectedItem="{Binding SelectedSettingsName, Mode=TwoWay}"
                         MouseDoubleClick="SettingsList_MouseDoubleClick" />
            </DockPanel>
        </Border>

        <!-- ============ Status line ============ -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource AudioLabSeparator}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Ellipse x:Name="StatusDot" DockPanel.Dock="Right" Width="10" Height="10" Margin="8,0,10,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource AudioLabStatusOk}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Fill" Value="{DynamicResource AudioLabStatusIdle}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorStatus}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource AudioLabStatusError}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="4,0"
                           Text="{Binding StatusInfo}" ToolTip="{Binding StatusInfo}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource AudioLabText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorStatus}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AudioLabErrorText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>

    <SolidColorBrush x:Key="AudioLabNoteBackground" Color="#FF2A2414" />
    <SolidColorBrush x:Key="AudioLabNoteBorder" Color="#FFF0B54A" />
    <SolidColorBrush x:Key="AudioLabNoteText" Color="#FFF3D9A4" />
    <SolidColorBrush x:Key="AudioLabListBackground" Color="#FF161B22" />
    <SolidColorBrush x:Key="AudioLabListText" Color="#FFE7EBF1" />
    <SolidColorBrush x:Key="AudioLabLogBackground" Color="#FF0E1116" />
    <SolidColorBrush x:Key="AudioLabLogText" Color="#FF9FE6C9" />

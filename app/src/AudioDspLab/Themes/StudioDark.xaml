    <SolidColorBrush x:Key="AudioLabMarkerP3" Color="#FFF2CC3E" />
    <SolidColorBrush x:Key="AudioLabMarkerP4" Color="#FFD9453B" />
    <SolidColorBrush x:Key="AudioLabDisplayTitle" Color="#FF8B97A8" />
    <SolidColorBrush x:Key="AudioLabDisplayFrame" Color="Transparent" />
    <SolidColorBrush x:Key="AudioLabDisplayValue" Color="#FFF2F5F9" />
    <SolidColorBrush x:Key="AudioLabDialSelection" Color="#FF2FC4B2" />
    <SolidColorBrush x:Key="AudioLabDialArrow" Color="#992FC4B2" />
    <SolidColorBrush x:Key="AudioLabChartBackground" Color="#FF141920" />
    <SolidColorBrush x:Key="AudioLabChartGrid" Color="#FF232B35" />
    <SolidColorBrush x:Key="AudioLabChartZero" Color="#FF4A5566" />

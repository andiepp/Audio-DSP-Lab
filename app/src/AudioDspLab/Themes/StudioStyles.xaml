<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The Studio styles, shared by Studio dark and Studio light: the same
         style keys as Classic.xaml, drawn as cards, rounded keys, switches
         and lit choice keys. Colours come from StudioDark.xaml or
         StudioLight.xaml, hence DynamicResource throughout. -->

    <Style x:Key="AudioLabHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AudioLabText}" />
        <Setter Property="Margin" Value="4,8,4,4" />
    </Style>

    <Style x:Key="AudioLabHeaderRuleStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="AudioLabInfoStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource AudioLabDimText}" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AudioLabUnitLineStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource AudioLabUnitText}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,3,0,2" />
    </Style>

    <Style x:Key="AudioLabSettingsBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AudioLabSettingsBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="2,0,2,4" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AudioLabTextOnBlock}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AudioLabSettingsLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AudioLabSettingsLabel}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="2,0,8,0" />
    </Style>

    <Style x:Key="AudioLabRadioStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource AudioLabText}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="2,4,14,4" />
    </Style>

    <Style x:Key="AudioLabEntryStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource AudioLabDigitFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="96" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource AudioLabText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AudioLabText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioLine}" />
    </Style>

    <!-- every other text box (settings name, stations, WiFi, console input) -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource AudioLabText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AudioLabText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioLine}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource StudioAccent}" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource AudioLabText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AudioLabText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioLine}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource AudioLabText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                                Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioLineHover}" BorderThickness="1">
                            <Path x:Name="Tick" Data="M 3.5,8 L 6.5,11 L 12.5,4.5" Stroke="{DynamicResource StudioOnAccent}"
                                  StrokeThickness="2" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource StudioAccent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the port and theme pickers -->
    <Style x:Key="StudioComboToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioLine}"
                            BorderThickness="1" CornerRadius="6">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                              Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource AudioLabDimText}" StrokeThickness="1.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource StudioLineHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource AudioLabText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource StudioComboToggleStyle}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <ContentPresenter Margin="8,0,22,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <Border Margin="0,2,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource AudioLabSettingsBackground}" BorderBrush="{DynamicResource StudioLine}"
                                    BorderThickness="1" CornerRadius="6" Padding="2">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource AudioLabText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="8,4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource StudioPressed}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AudioLabAccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioLine}" />
    </Style>

    <!-- Keys: rounded, quiet; the accent only where it means something. -->
    <Style x:Key="AudioLabKeyStyle" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource AudioLabText}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Overlay" Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioLine}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="BorderBrush" Value="{DynamicResource StudioLineHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource StudioPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The deliberate keys (Connect, Enter service, Apply ...): accent-filled. -->
    <Style x:Key="AudioLabGoldKeyStyle" TargetType="Button" BasedOn="{StaticResource AudioLabKeyStyle}">
        <Setter Property="Foreground" Value="{DynamicResource StudioOnAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Overlay" Background="{DynamicResource StudioAccent}" BorderBrush="{DynamicResource StudioAccent}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource StudioSurface}" />
                            <Setter TargetName="Overlay" Property="BorderBrush" Value="{DynamicResource StudioLine}" />
                            <Setter Property="Foreground" Value="{DynamicResource AudioLabDimText}" />
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.6" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On/off keys: a switch, its label beside it. -->
    <Style x:Key="AudioLabToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource AudioLabKeyStyle}">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Overlay" Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioLine}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <DockPanel VerticalAlignment="Center">
                            <Border x:Name="Track" DockPanel.Dock="Left" Width="32" Height="18" CornerRadius="9"
                                    Background="{DynamicResource StudioLine}" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="2,0" HorizontalAlignment="Left"
                                         Fill="{DynamicResource AudioLabText}" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource StudioAccent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource StudioOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="BorderBrush" Value="{DynamicResource StudioLineHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A pill for the application's state. -->
    <Style x:Key="AudioLabStatePillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AudioLabText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsStateRunning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource StudioAccent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioOnAccent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsServiceMode}" Value="True">
                <Setter Property="Background" Value="{DynamicResource StudioCaution}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StudioCaution}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioOnAccent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsStateFailed}" Value="True">
                <Setter Property="Background" Value="{DynamicResource StudioDanger}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StudioDanger}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioOnDanger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A choice key (application, station, waveform ...): lit with the
         accent while it is the board's choice. Not a toggle: a click on the
         choice already made changes nothing, and the key must not pretend
         it did. -->
    <Style x:Key="AudioLabStationKeyStyle" TargetType="Button" BasedOn="{StaticResource AudioLabKeyStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Overlay" Background="{DynamicResource StudioSurface}" BorderBrush="{DynamicResource StudioLine}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="BorderBrush" Value="{DynamicResource StudioLineHover}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource StudioAccent}" />
                            <Setter TargetName="Overlay" Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource StudioOnAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The radio's connection, as a pill coloured by what it means. -->
    <Style x:Key="AudioLabConnectionPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StudioLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AudioLabText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                <Setter Property="Background" Value="{DynamicResource StudioAccent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioOnAccent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                <Setter Property="Background" Value="{DynamicResource StudioCaution}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StudioCaution}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioOnAccent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsConnectionFailed}" Value="True">
                <Setter Property="Background" Value="{DynamicResource StudioDanger}" />
                <Setter Property="BorderBrush" Value="{DynamicResource StudioDanger}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource StudioOnDanger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
